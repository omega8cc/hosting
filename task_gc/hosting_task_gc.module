<?php

/**
 * @file
 * Module code for Hosting task garbage collection
 */

/**
 * Implements hook_hosting_queues().
 *
 * Return a list of queues that this module needs to manage.
 */
function hosting_task_gc_hosting_queues() {
  $count = hosting_task_gc_count();
  $queue['task_gc'] = array(
    'name' => t('Task GC'),
    'description' => t('Collect the tasks of deleted sites and platforms, old task logs, package leftovers, the context names of deleted sites and of nodes that are gone, and the queued revisions of finished tasks.'),
    // Run queue sequentially. always with the same parameters.
    'type' => HOSTING_QUEUE_TYPE_BATCH,
    'frequency' => strtotime("1 hour", 0),
    'items' => 20,
    'total_items' => $count,
    'min_threads' => 6,
    'max_threads' => 12,
    'threshold' => 100,
    'singular' => t('item'),
    'plural' => t('items'),
  );
  return $queue;
}

/**
 * The main queue callback task_gc.
 *
 * Every leg is bounded, so one run never holds a table for long; what is
 * left waits for the next run.
 */
function hosting_task_gc_queue() {
  global $user;

  // Prevent session information from being saved while queue is running.
  $original_session_saving = drupal_save_session();
  drupal_save_session(FALSE);

  // Switch to the super user.
  $old_user = $user;
  $user = user_load(1);

  // Tasks of deleted sites and platforms, tasks whose referenced node is
  // gone, and task rows whose own node is gone.
  $budget = max(1, (int) variable_get('hosting_task_gc_tasks_per_run', 200));
  foreach (hosting_task_gc_list_entities() as $nid) {
    if ($budget <= 0) {
      break;
    }
    $budget -= hosting_task_gc_delete_tasks($nid, $budget);
  }
  if ($budget > 0) {
    $budget -= hosting_task_gc_delete_orphan_tasks($budget);
  }
  if ($budget > 0) {
    $budget -= hosting_task_gc_delete_nodeless_rows($budget);
  }

  // Restore the user.
  $user = $old_user;
  drupal_save_session($original_session_saving);

  // Look for orphaned task log entries.
  $query = "SELECT DISTINCT h.vid
              FROM {hosting_task_log} h
                LEFT OUTER JOIN {node_revision} n ON h.vid = n.vid
              WHERE n.vid IS NULL LIMIT 100";
  $result = db_query($query);
  while ($revision = $result->fetchObject()) {
    $num = db_delete('hosting_task_log')
      ->condition('vid', $revision->vid)
      ->execute();
    watchdog('hosting_task_gc', 'Deleted @num orphaned task log entries with vid @vid.', array('@num' => $num, '@vid' => $revision->vid));
  }

  $pruned = hosting_task_gc_prune_logs();
  if ($pruned) {
    watchdog('hosting_task_gc', 'Deleted @num task log entries older than the configured age.', array('@num' => $pruned));
  }

  if (function_exists('hosting_package_instances_gc')) {
    $removed = hosting_package_instances_gc(variable_get('hosting_task_gc_instances_per_run', 2000));
    if ($removed) {
      watchdog('hosting_task_gc', 'Deleted @num package instances of deleted platforms.', array('@num' => $removed));
    }
  }

  $released = hosting_task_gc_delete_stale_contexts(variable_get('hosting_task_gc_contexts_per_run', 200));
  if ($released) {
    watchdog('hosting_task_gc', 'Released @num context name(s) of deleted sites or gone nodes.', array('@num' => $released));
  }

  $pruned = hosting_task_gc_prune_queued_revisions(variable_get('hosting_task_gc_revisions_per_run', 1000));
  if ($pruned) {
    watchdog('hosting_task_gc', 'Deleted @num queued revision(s) of finished tasks.', array('@num' => $pruned));
  }

  $removed = hosting_task_gc_delete_unused_packages(variable_get('hosting_task_gc_packages_per_run', 100));
  if ($removed) {
    watchdog('hosting_task_gc', 'Deleted @num package node(s) no platform or site carries.', array('@num' => $removed));
  }

  $removed = hosting_task_gc_delete_stale_backups(variable_get('hosting_task_gc_backups_per_run', 500));
  if ($removed) {
    watchdog('hosting_task_gc', 'Deleted @num backup record(s) of deleted sites whose file is gone.', array('@num' => $removed));
  }

  $removed = hosting_task_gc_delete_site_rows(variable_get('hosting_task_gc_site_rows_per_run', 500));
  if ($removed) {
    watchdog('hosting_task_gc', 'Deleted the cron and alias rows of @num deleted or gone site(s).', array('@num' => $removed));
  }

  // The next dispatch counts again, so the queue idles once everything is
  // collected and wakes as soon as there is more.
  cache_clear_all('hosting_task_gc_count_sites', 'cache');
}

/**
 * Deleted sites and platforms that still have finished tasks.
 *
 * @return array
 *   Node ids, a few of each kind, oldest first.
 */
function hosting_task_gc_list_entities() {
  $sites = db_query_range("SELECT DISTINCT s.nid
                           FROM {hosting_site} s INNER JOIN {hosting_task} t ON s.nid = t.rid
                           WHERE s.status = :status ORDER BY s.nid", 0, 5, array(':status' => HOSTING_SITE_DELETED))->fetchCol();
  $platforms = db_query_range("SELECT DISTINCT p.nid
                               FROM {hosting_platform} p INNER JOIN {hosting_task} t ON p.nid = t.rid
                               WHERE p.status = :status ORDER BY p.nid", 0, 5, array(':status' => HOSTING_PLATFORM_DELETED))->fetchCol();
  return array_merge($sites, $platforms);
}

/**
 * Delete the finished tasks of a node, at most $limit of them.
 *
 * A task still queued or running (the delete task of the platform itself
 * marks the platform deleted before it finishes) is left for a later run.
 *
 * @return int
 *   The number of task nodes deleted.
 */
function hosting_task_gc_delete_tasks($rid, $limit) {
  $tasks = db_query_range("SELECT DISTINCT t.nid
                           FROM {hosting_task} t INNER JOIN {node} n ON n.vid = t.vid
                           WHERE t.rid = :rid AND t.task_status NOT IN (:live)
                           ORDER BY t.nid", 0, max(1, (int) $limit),
                           array(':rid' => $rid, ':live' => array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING)))->fetchCol();
  return hosting_task_gc_delete_task_nodes($tasks);
}

/**
 * Delete tasks whose referenced node no longer exists, at most $limit.
 *
 * @return int
 *   The number of task nodes deleted.
 */
function hosting_task_gc_delete_orphan_tasks($limit) {
  $tasks = db_query_range("SELECT DISTINCT t.nid
                           FROM {hosting_task} t LEFT JOIN {node} r ON r.nid = t.rid
                           WHERE r.nid IS NULL ORDER BY t.nid", 0, max(1, (int) $limit))->fetchCol();
  return hosting_task_gc_delete_task_nodes($tasks);
}

/**
 * Delete task rows whose own task node no longer exists, at most $limit.
 *
 * A node deleted past the task module's hook leaves its hosting_task,
 * argument and log rows behind; node_delete() cannot reach them.
 *
 * @return int
 *   The number of task ids cleaned.
 */
function hosting_task_gc_delete_nodeless_rows($limit) {
  $nids = db_query_range("SELECT DISTINCT t.nid
                          FROM {hosting_task} t LEFT JOIN {node} n ON n.nid = t.nid
                          WHERE n.nid IS NULL ORDER BY t.nid", 0, max(1, (int) $limit))->fetchCol();
  return hosting_task_gc_delete_task_rows($nids);
}

/**
 * Delete task nodes in batches; hook_delete removes their rows and logs.
 *
 * Rows a node delete could not reach (a task node that no longer loads) are
 * removed directly, so a run never spends its budget on the same ids again.
 *
 * @return int
 *   The number of task nodes deleted.
 */
function hosting_task_gc_delete_task_nodes($nids) {
  $nids = array_values(array_unique(array_filter(array_map('intval', (array) $nids))));
  if (empty($nids)) {
    return 0;
  }
  foreach (array_chunk($nids, 50) as $chunk) {
    node_delete_multiple($chunk);
    hosting_task_gc_delete_task_rows($chunk);
  }
  watchdog('hosting_task_gc', 'Deleted @num task node(s).', array('@num' => count($nids)));
  return count($nids);
}

/**
 * Delete the task, argument and log rows of the given task ids.
 *
 * @return int
 *   The number of task ids cleaned.
 */
function hosting_task_gc_delete_task_rows($nids) {
  $nids = array_values(array_unique(array_filter(array_map('intval', (array) $nids))));
  if (empty($nids)) {
    return 0;
  }
  foreach (array_chunk($nids, 50) as $chunk) {
    db_delete('hosting_task_log')
      ->condition('nid', $chunk, 'IN')
      ->execute();
    db_delete('hosting_task_arguments')
      ->condition('nid', $chunk, 'IN')
      ->execute();
    db_delete('hosting_task')
      ->condition('nid', $chunk, 'IN')
      ->execute();
  }
  return count($nids);
}

/**
 * Delete task log entries older than the configured age.
 *
 * The age defaults to three months; 0 keeps every entry.
 *
 * @return int
 *   The number of rows deleted.
 */
function hosting_task_gc_prune_logs() {
  $age = (int) variable_get('hosting_task_gc_log_age', 7776000);
  if ($age <= 0) {
    return 0;
  }
  $limit = max(1, (int) variable_get('hosting_task_gc_logs_per_run', 5000));
  return (int) db_query("DELETE FROM {hosting_task_log} WHERE timestamp < :cutoff LIMIT " . $limit, array(':cutoff' => REQUEST_TIME - $age))->rowCount();
}

/**
 * Release the context names of deleted sites and of gone nodes, at most $limit.
 *
 * A site's delete task removes its context row; a row left behind (a delete
 * that never finished, a node removed past the hooks) keeps a name no other
 * node can take. Platforms are left alone whatever their status: BOA parks
 * old panel platforms at the deleted status and deletes them later by their
 * context name, so their rows are released only on demand, by
 * hosting_context_register() when another node needs the name.
 *
 * @return int
 *   The number of rows released.
 */
function hosting_task_gc_delete_stale_contexts($limit) {
  $nids = db_query_range(hosting_task_gc_stale_contexts_sql(), 0, max(1, (int) $limit), hosting_task_gc_stale_contexts_args())->fetchCol();
  foreach ($nids as $nid) {
    hosting_context_delete($nid);
  }
  return count($nids);
}

/**
 * Whether any context row names a deleted site or a node that is gone.
 */
function hosting_task_gc_stale_contexts_pending() {
  return (bool) db_query_range(hosting_task_gc_stale_contexts_sql(), 0, 1, hosting_task_gc_stale_contexts_args())->fetchField();
}

/**
 * The stale context rows, oldest node first; status read on the current revision.
 */
function hosting_task_gc_stale_contexts_sql() {
  return "SELECT c.nid FROM {hosting_context} c
            LEFT JOIN {node} n ON n.nid = c.nid
            LEFT JOIN {hosting_site} s ON s.nid = c.nid AND s.vid = n.vid
          WHERE n.nid IS NULL
             OR (n.type = 'site' AND s.status = :site_deleted)
          ORDER BY c.nid";
}

/**
 * The placeholders of hosting_task_gc_stale_contexts_sql().
 */
function hosting_task_gc_stale_contexts_args() {
  return array(':site_deleted' => HOSTING_SITE_DELETED);
}

/**
 * Delete the queued revisions of finished tasks, at most $limit of them.
 *
 * The runner opens a new revision when it takes a task, so every task that
 * ran keeps its original queued revision beside the one that holds its
 * outcome and logs: a second hosting_task row per task, status queued for
 * good, which every scan of the table had to read. Only revisions whose own
 * row still says queued go; an older executed revision (a retry's previous
 * run) keeps its logs.
 *
 * @return int
 *   The number of revisions deleted.
 */
function hosting_task_gc_prune_queued_revisions($limit) {
  $vids = db_query_range(hosting_task_gc_queued_revisions_sql(), 0, max(1, (int) $limit), hosting_task_gc_queued_revisions_args())->fetchCol();
  foreach ($vids as $vid) {
    // hook_node_revision_delete() removes the revision's task, argument and
    // log rows.
    node_revision_delete($vid);
  }
  return count($vids);
}

/**
 * Whether any finished task still has a queued revision.
 */
function hosting_task_gc_queued_revisions_pending() {
  return (bool) db_query_range(hosting_task_gc_queued_revisions_sql(), 0, 1, hosting_task_gc_queued_revisions_args())->fetchField();
}

/**
 * The queued, non-current revisions of tasks whose current revision is done.
 */
function hosting_task_gc_queued_revisions_sql() {
  return "SELECT r.vid FROM {node_revision} r
            INNER JOIN {node} n ON n.nid = r.nid AND n.vid <> r.vid
            INNER JOIN {hosting_task} t ON t.vid = r.vid
            INNER JOIN {hosting_task} c ON c.vid = n.vid
          WHERE n.type = 'task'
            AND t.task_status = :queued
            AND c.task_status NOT IN (:live)
          ORDER BY r.vid";
}

/**
 * The placeholders of hosting_task_gc_queued_revisions_sql().
 */
function hosting_task_gc_queued_revisions_args() {
  return array(':queued' => HOSTING_TASK_QUEUED, ':live' => array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING));
}

/**
 * Delete package nodes no platform or site carries, at most $limit of them.
 *
 * A package node is the registry entry of a module, theme, profile or
 * distribution; the instance rows name the platforms and sites that carry
 * it. Deleting a platform removes its instances and never the package nodes,
 * so a long-lived panel keeps every package that ever shipped on any
 * platform. Only nodes older than a day go: a verify creates the node a
 * moment before it writes the first instance. hook_delete() removes the
 * package row; the next verify of a carrier creates the node again.
 *
 * @return int
 *   The number of nodes deleted.
 */
function hosting_task_gc_delete_unused_packages($limit) {
  // A running verify may be writing the first instance of a node this leg
  // would read as unused: wait for a quiet run.
  if (hosting_task_gc_tasks_running()) {
    return 0;
  }
  $nids = db_query_range(hosting_task_gc_unused_packages_sql(), 0, max(1, (int) $limit), hosting_task_gc_unused_packages_args())->fetchCol();
  if ($nids) {
    // Read again right before the delete: a task that started meanwhile may
    // have named one of them.
    $nids = db_query("SELECT n.nid FROM {node} n
                        LEFT JOIN {hosting_package_instance} i ON i.package_id = n.nid
                      WHERE n.nid IN (:nids) AND i.iid IS NULL", array(':nids' => $nids))->fetchCol();
  }
  if ($nids && !hosting_task_gc_tasks_running()) {
    node_delete_multiple($nids);
    return count($nids);
  }
  return 0;
}

/**
 * Whether a package node no instance names exists.
 */
function hosting_task_gc_unused_packages_pending() {
  return (bool) db_query_range(hosting_task_gc_unused_packages_sql(), 0, 1, hosting_task_gc_unused_packages_args())->fetchField();
}

/**
 * The package nodes without an instance, oldest first.
 */
function hosting_task_gc_unused_packages_sql() {
  // A site's profile names its package node directly, instance or not.
  return "SELECT n.nid FROM {node} n
            LEFT JOIN {hosting_package_instance} i ON i.package_id = n.nid
          WHERE n.type = 'package' AND i.iid IS NULL AND n.created < :cutoff
            AND n.nid NOT IN (SELECT s.profile FROM {hosting_site} s WHERE s.profile > 0)
          ORDER BY n.nid";
}

/**
 * Whether a task is running on this panel right now (current revisions).
 */
function hosting_task_gc_tasks_running() {
  return (bool) db_query_range("SELECT t.nid FROM {hosting_task} t INNER JOIN {node} n ON n.vid = t.vid WHERE t.task_status = :processing", 0, 1, array(':processing' => HOSTING_TASK_PROCESSING))->fetchField();
}

/**
 * The placeholders of hosting_task_gc_unused_packages_sql().
 */
function hosting_task_gc_unused_packages_args() {
  return array(':cutoff' => REQUEST_TIME - 86400);
}

/**
 * Delete the backup records of deleted sites whose file is gone, at most
 * $limit of them.
 *
 * A site's delete task records its last backup and nothing removes the row
 * afterwards; the backup files are purged after their retention, so the rows
 * point at nothing for good. A record whose file still exists stays until
 * the file goes; a record of a site node that is gone goes in any case. Only
 * records on this server are judged by their file.
 *
 * @return int
 *   The number of records deleted.
 */
function hosting_task_gc_delete_stale_backups($limit) {
  $limit = max(1, (int) $limit);
  $bids = array();
  // Records whose file still exists stay and would fill a window of the
  // oldest rows for good, so four windows are read for one window of deletes.
  foreach (hosting_task_gc_stale_backups_rows($limit * 4) as $row) {
    if (hosting_task_gc_backup_record_is_stale($row)) {
      $bids[] = $row->bid;
      if (count($bids) >= $limit) {
        break;
      }
    }
  }
  if ($bids) {
    db_delete('hosting_site_backups')->condition('bid', $bids, 'IN')->execute();
  }
  return count($bids);
}

/**
 * Whether a backup record of a gone or deleted site points at no file.
 */
function hosting_task_gc_stale_backups_pending() {
  foreach (hosting_task_gc_stale_backups_rows(max(1, (int) variable_get('hosting_task_gc_backups_per_run', 500)) * 4) as $row) {
    if (hosting_task_gc_backup_record_is_stale($row)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Whether a record of a gone or deleted site can go: the site node is gone,
 * or the file is gone from a directory this panel can read. A directory it
 * cannot read (a store not mounted right now) says nothing about the file.
 */
function hosting_task_gc_backup_record_is_stale($row) {
  if (!empty($row->gone)) {
    return TRUE;
  }
  $dir = dirname($row->filename);
  if (!is_dir($dir) || !is_readable($dir)) {
    return FALSE;
  }
  return !file_exists($row->filename);
}

/**
 * The backup records of gone or deleted sites on this server, oldest first.
 *
 * @return array
 *   Rows with bid, filename and gone (1 when the site node is gone).
 */
function hosting_task_gc_stale_backups_rows($limit) {
  $master = (int) db_query("SELECT nid FROM {hosting_context} WHERE name = :name", array(':name' => 'server_master'))->fetchField();
  if (!$master) {
    return array();
  }
  return db_query_range("SELECT b.bid, b.filename, (n.nid IS NULL) AS gone
                           FROM {hosting_site_backups} b
                           LEFT JOIN {node} n ON n.nid = b.site
                           LEFT JOIN {hosting_site} s ON s.nid = b.site AND s.vid = n.vid
                         WHERE b.web_server = :master
                           AND (n.nid IS NULL OR (n.type = 'site' AND s.status = :site_deleted))
                         ORDER BY b.timestamp, b.bid", 0, max(1, (int) $limit), array(':master' => $master, ':site_deleted' => HOSTING_SITE_DELETED))->fetchAll();
}

/**
 * Delete the cron and alias rows of deleted or gone sites, at most $limit
 * sites per run.
 *
 * Both tables are cleaned by hook_node_delete() only, which a site's delete
 * task never fires: the site node stays, recorded as deleted, with its
 * interval and aliases beside it for good.
 *
 * @return int
 *   The number of sites whose rows were deleted.
 */
function hosting_task_gc_delete_site_rows($limit) {
  $nids = db_query_range(hosting_task_gc_site_rows_sql(), 0, max(1, (int) $limit), hosting_task_gc_site_rows_args())->fetchCol();
  if ($nids) {
    db_delete('hosting_cron')->condition('nid', $nids, 'IN')->execute();
    db_delete('hosting_site_alias')->condition('nid', $nids, 'IN')->execute();
  }
  return count($nids);
}

/**
 * Whether a cron or alias row of a deleted or gone site exists.
 */
function hosting_task_gc_site_rows_pending() {
  return (bool) db_query_range(hosting_task_gc_site_rows_sql(), 0, 1, hosting_task_gc_site_rows_args())->fetchField();
}

/**
 * The sites with cron or alias rows that are deleted or gone, lowest nid first.
 */
function hosting_task_gc_site_rows_sql() {
  return "SELECT DISTINCT x.nid FROM (SELECT nid FROM {hosting_cron} UNION SELECT nid FROM {hosting_site_alias}) x
            LEFT JOIN {node} n ON n.nid = x.nid
            LEFT JOIN {hosting_site} s ON s.nid = x.nid AND s.vid = n.vid
          WHERE n.nid IS NULL
             OR (n.type = 'site' AND s.status = :site_deleted)
          ORDER BY x.nid";
}

/**
 * The placeholders of hosting_task_gc_site_rows_sql().
 */
function hosting_task_gc_site_rows_args() {
  return array(':site_deleted' => HOSTING_SITE_DELETED);
}

/**
 * Whether any task log entry is older than the configured age.
 */
function hosting_task_gc_old_logs_pending() {
  $age = (int) variable_get('hosting_task_gc_log_age', 7776000);
  if ($age <= 0) {
    return FALSE;
  }
  return (bool) db_query_range("SELECT 1 FROM {hosting_task_log} WHERE timestamp < :cutoff", 0, 1, array(':cutoff' => REQUEST_TIME - $age))->fetchField();
}

/**
 * Prepare a list of sites with garbage to collect.
 *
 * @return DatabaseStatementInterface
 *   A result object.
 */
function hosting_task_gc_list_sites() {
  $query = "SELECT DISTINCT s.nid "
          . "FROM {hosting_site} s INNER JOIN {hosting_task} t ON s.nid = t.rid "
          . "WHERE s.status = :status LIMIT 5";
  return db_query($query, array(':status' => HOSTING_SITE_DELETED));
}

/**
 * Get the number of items with garbage to collect.
 *
 * Deleted sites and platforms that still have tasks, tasks whose node is
 * gone, task rows whose own node is gone, plus one each for old task logs,
 * package leftovers, stale context names and queued revisions of finished
 * tasks when any are pending. The queue only runs while this
 * is above zero.
 *
 * @return int
 *   The number of items.
 */
function hosting_task_gc_count() {
  // This query can be super expensive to run, so only run it once every hour
  // (the cache layer does not expire an entry by itself).
  $cache = cache_get('hosting_task_gc_count_sites');
  if ($cache && !empty($cache->expire) && $cache->expire > REQUEST_TIME) {
    return $cache->data;
  }
  $count = (int) db_query("SELECT COUNT(DISTINCT s.nid)
                           FROM {hosting_site} s INNER JOIN {hosting_task} t ON s.nid = t.rid
                           WHERE s.status = :status", array(':status' => HOSTING_SITE_DELETED))->fetchField();
  $count += (int) db_query("SELECT COUNT(DISTINCT p.nid)
                            FROM {hosting_platform} p INNER JOIN {hosting_task} t ON p.nid = t.rid
                            WHERE p.status = :status", array(':status' => HOSTING_PLATFORM_DELETED))->fetchField();
  $count += (int) db_query("SELECT COUNT(DISTINCT t.nid)
                            FROM {hosting_task} t LEFT JOIN {node} r ON r.nid = t.rid
                            WHERE r.nid IS NULL")->fetchField();
  $count += (int) db_query("SELECT COUNT(DISTINCT t.nid)
                            FROM {hosting_task} t LEFT JOIN {node} n ON n.nid = t.nid
                            WHERE n.nid IS NULL")->fetchField();
  if (hosting_task_gc_old_logs_pending()) {
    $count++;
  }
  if (function_exists('hosting_package_instances_gc_pending') && hosting_package_instances_gc_pending()) {
    $count++;
  }
  if (hosting_task_gc_stale_contexts_pending()) {
    $count++;
  }
  if (hosting_task_gc_queued_revisions_pending()) {
    $count++;
  }
  if (hosting_task_gc_unused_packages_pending()) {
    $count++;
  }
  if (hosting_task_gc_stale_backups_pending()) {
    $count++;
  }
  if (hosting_task_gc_site_rows_pending()) {
    $count++;
  }
  cache_set('hosting_task_gc_count_sites', $count, 'cache', REQUEST_TIME + 3600);
  return $count;
}

/**
 * Get the number of items with garbage to collect.
 *
 * Kept for callers of the old name; see hosting_task_gc_count().
 */
function hosting_task_gc_count_sites() {
  return hosting_task_gc_count();
}

/**
 * Implements hook_node_update().
 */
function hosting_task_gc_node_update($node) {
  if ($node->type == "site") {
    if (isset($node->site_status) && $node->site_status == HOSTING_SITE_DELETED) {
      cache_clear_all('hosting_task_gc_count_sites', 'cache');
    }
  }
  if ($node->type == "platform") {
    if (isset($node->platform_status) && $node->platform_status == HOSTING_PLATFORM_DELETED) {
      cache_clear_all('hosting_task_gc_count_sites', 'cache');
    }
  }
}
