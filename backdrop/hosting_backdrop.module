<?php
/**
 * @file
 * Backdrop CMS platform support for the Aegir frontend.
 *
 * The frontend is version-agnostic: no node column records "Drupal vs Backdrop".
 * The backend (provision-backdrop) reports the Backdrop signal on platform
 * verify as $data['backdrop'] = the Backdrop version string. This module stores
 * that marker per platform, then uses it to (a) keep Backdrop and Drupal
 * platforms from being offered together at site creation and (b) route Backdrop
 * site installs through the Backdrop install path via context_options.
 *
 * PHP 5.6 floor: this file is loaded under the Drush-8 backend and must stay
 * 5.6-parseable and 5.6-runtime-correct (no ??, arrow fns, scalar hints, match).
 */

/**
 * Variable-name prefix for the per-platform Backdrop version marker.
 *
 * Keyed by platform nid; the value is the reported Backdrop version string.
 * Table-free storage (the {variable} table) keeps this a pure submodule with no
 * schema change to the shared hosting_platform table.
 */
define('HOSTING_BACKDROP_PLATFORM_VAR', 'hosting_backdrop_platform_version_');

/**
 * The install_method value provision-backdrop expects for Backdrop site nodes.
 */
define('HOSTING_BACKDROP_INSTALL_METHOD', 'backdrop');

/**
 * Determine whether a platform node is a verified Backdrop platform.
 *
 * @param int $platform_nid
 *   The platform node id.
 *
 * @return bool
 *   TRUE if the backend reported a Backdrop version for this platform.
 */
function hosting_backdrop_platform_is_backdrop($platform_nid) {
  if (empty($platform_nid)) {
    return FALSE;
  }
  $version = variable_get(HOSTING_BACKDROP_PLATFORM_VAR . $platform_nid, '');
  return $version !== '';
}

/**
 * Return the stored Backdrop version string for a platform, or ''.
 */
function hosting_backdrop_platform_version($platform_nid) {
  if (empty($platform_nid)) {
    return '';
  }
  return variable_get(HOSTING_BACKDROP_PLATFORM_VAR . $platform_nid, '');
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Stores (or clears) the per-platform Backdrop marker from the verify result.
 * The backend contract: provision-backdrop's platform verify adds
 * $data['backdrop'] = the Backdrop version string alongside the standard
 * packages/profiles/sites keys. Presence of that key is the Backdrop signal.
 */
function hosting_backdrop_post_hosting_verify_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'platform') {
    return;
  }
  $name = HOSTING_BACKDROP_PLATFORM_VAR . $task->ref->nid;

  // Read the reported version; tolerate it arriving nested under 'context'.
  $version = '';
  if (isset($data['backdrop']) && is_string($data['backdrop'])) {
    $version = trim($data['backdrop']);
  }
  elseif (isset($data['context']['backdrop']) && is_string($data['context']['backdrop'])) {
    $version = trim($data['context']['backdrop']);
  }

  if ($version !== '') {
    // Only write on change to avoid needless variable-cache invalidation.
    if (variable_get($name, '') !== $version) {
      variable_set($name, $version);
    }
  }
  else {
    // Re-verified as a non-Backdrop platform: drop any stale marker. Guard the
    // delete so a normal Drupal verify never clears the bootstrap cache.
    if (variable_get($name, NULL) !== NULL) {
      variable_del($name);
    }
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Cleans up the per-platform marker when a platform is deleted.
 */
function hosting_backdrop_post_hosting_delete_task($task, $data) {
  if (isset($task->ref) && $task->ref->type == 'platform') {
    $name = HOSTING_BACKDROP_PLATFORM_VAR . $task->ref->nid;
    if (variable_get($name, NULL) !== NULL) {
      variable_del($name);
    }
  }
}

/**
 * Implements hook_hosting_site_options_alter().
 *
 * Partition the platform options so Backdrop and Drupal platforms are never
 * offered together. The reference is the platform currently selected on the
 * node; hosting_site_available_options() guarantees it is a member of the list.
 * The == predicate is symmetric, so this strips cross-CMS targets in BOTH
 * directions wherever hosting_site_available_options() gates the platform
 * list: site create, per-site migrate, and clone (which reuses the migrate
 * form). The platform-batch migrate form bypasses this alter entirely; that
 * path is contained by the backend provision-migrate any-Backdrop guard.
 */
function hosting_backdrop_hosting_site_options_alter(&$return, &$node) {
  if (empty($return['platform']) || !is_array($return['platform'])) {
    return;
  }

  $reference = isset($node->platform) ? $node->platform : reset($return['platform']);
  if (empty($reference)) {
    return;
  }
  $reference_is_backdrop = hosting_backdrop_platform_is_backdrop($reference);

  $filtered = array();
  foreach ($return['platform'] as $nid) {
    if (hosting_backdrop_platform_is_backdrop($nid) == $reference_is_backdrop) {
      $filtered[] = $nid;
    }
  }

  // Never present an empty platform list; only apply a non-empty partition.
  if (!empty($filtered)) {
    $return['platform'] = $filtered;
  }
}

/**
 * Implements hook_permission().
 *
 * The "create TASK_TYPE task" permission string is load-bearing:
 * hosting_task_menu_access() gates both the Run button and the confirm path
 * on user_access("create backdrop_upgrade task").
 */
function hosting_backdrop_permission() {
  return array(
    'create backdrop_upgrade task' => array(
      'title' => t('create backdrop_upgrade task'),
    ),
  );
}

/**
 * Implements hook_hosting_tasks().
 *
 * The 'command' key is mandatory: the default derivation would yield
 * provision-backdrop_upgrade (underscore), which does not exist. The backend
 * command is provision-backdrop-upgrade, a clone-preserving upgrade — the
 * source site, database, and vhost are never in the write path.
 */
function hosting_backdrop_hosting_tasks() {
  $tasks = array();

  $tasks['site']['backdrop_upgrade'] = array(
    'title' => t('Upgrade to Backdrop'),
    'description' => t('Copy this Drupal 7 site onto a Backdrop platform at a NEW domain name and convert the copy in place. The original site keeps serving throughout — its database and files are never in the write path; test the copy, then switch over deliberately. The copy starts with Encryption and cron disabled, and modules without a Backdrop 1.x version are disabled by the conversion (their data tables are kept). A per-module compatibility report is written to the task log during validation, before anything is created.'),
    'command' => 'provision-backdrop-upgrade',
    'dialog' => TRUE,
    'access callback' => 'hosting_backdrop_upgrade_task_access',
  );

  return $tasks;
}

/**
 * Return the available upgrade targets: verified Backdrop platforms.
 *
 * Marker presence already implies a verified, non-deleted Backdrop platform
 * (the marker is written on platform verify and cleared on delete);
 * _hosting_get_platforms(0, TRUE) additionally drops locked ones. Titles
 * are check_plain()ed for direct use as radio option labels.
 */
function _hosting_backdrop_upgrade_targets() {
  $targets = array();
  foreach (_hosting_get_platforms(0, TRUE) as $nid => $title) {
    if (hosting_backdrop_platform_is_backdrop($nid)) {
      $targets[$nid] = check_plain($title);
    }
  }
  return $targets;
}

/**
 * Access callback for the backdrop_upgrade task.
 *
 * Runs in two contexts with the same ($node, $task) signature: button
 * rendering in hosting_task_fetch_tasks() and the hosting_confirm menu item
 * (where this callback REPLACES hosting_task_menu_access_csrf). It therefore
 * must not require the URL token — none exists at button-render time. That
 * matches the CSRF posture of the interactive migrate/clone tasks: the dialog
 * GET only renders a form; queueing happens on the token-protected POST.
 */
function hosting_backdrop_upgrade_task_access($node, $task) {
  // Standard checks: permission, site state, hostmaster guard.
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  // Only Drupal-lineage sources can be upgraded; hide the task on sites that
  // already sit on a (marker-verified) Backdrop platform.
  if (!isset($node->platform) || hosting_backdrop_platform_is_backdrop($node->platform)) {
    return FALSE;
  }
  // No verified Backdrop platform yet: hide the task rather than offering a
  // dead-end form.
  if (!count(_hosting_backdrop_upgrade_targets())) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements the backdrop_upgrade task confirmation form.
 *
 * Discovered by hosting_task_confirm_form() via function_exists(); the
 * returned elements are merged under $form['parameters'] (#tree), so their
 * values land verbatim in $task->task_args.
 */
function hosting_task_backdrop_upgrade_form($node) {
  $form = array();

  $form['new_uri'] = array(
    '#type' => 'textfield',
    '#title' => t('New domain name'),
    '#description' => t('The upgraded Backdrop copy is created at this new domain. The original site keeps serving at its current domain until you switch over deliberately.'),
    '#required' => TRUE,
    '#weight' => -1,
  );

  // Marker-verified Backdrop targets only. The access callback already hides
  // the task when this list is empty; the no-target branch below is defence
  // in depth for a direct request racing a platform lock/delete.
  $targets = _hosting_backdrop_upgrade_targets();
  if (count($targets)) {
    $form['target_platform'] = array(
      '#type' => 'radios',
      '#title' => t('Target Backdrop platform'),
      '#required' => TRUE,
      '#options' => $targets,
      '#default_value' => count($targets) == 1 ? key($targets) : NULL,
    );
  }
  else {
    $form['no_target'] = array(
      '#type' => 'item',
      '#title' => t('Target Backdrop platform'),
      '#markup' => t('No verified Backdrop platform is available. Add a Backdrop platform and verify it first.'),
    );
  }

  $db_servers = hosting_get_servers('db');
  if (count($db_servers) > 1) {
    $form['new_db_server'] = array(
      '#type' => 'radios',
      '#title' => t('Database server'),
      '#required' => TRUE,
      '#description' => t('The database server hosting the copy database.'),
      '#options' => $db_servers,
      '#default_value' => $node->db_server,
    );
  }
  else {
    $form['new_db_server'] = array(
      '#type' => 'hidden',
      '#value' => $node->db_server,
    );
  }

  $form['module_report'] = array(
    '#type' => 'item',
    '#title' => t('Module compatibility'),
    '#markup' => t('The per-module classification (moved to Backdrop core, available as contrib, no equivalent) is single-homed on the backend and reported in the task log during validation, before any copy is created. Review it there; enabled modules without a Backdrop 1.x version are disabled by the conversion and their data tables are kept.'),
  );

  $form['#node'] = $node;
  return $form;
}

/**
 * Validation for the backdrop_upgrade task confirmation form.
 *
 * The backend validate re-checks everything fail-closed (schema gate, target
 * platform, free URI); this front check exists so operator mistakes surface
 * in the form, not minutes later in a red task log.
 */
function hosting_task_backdrop_upgrade_form_validate($form, &$form_state) {
  $site = $form['parameters']['#node'];
  $params = $form_state['values']['parameters'];

  if (isset($site->platform) && hosting_backdrop_platform_is_backdrop($site->platform)) {
    form_set_error('parameters][target_platform', t('This site already runs on a Backdrop platform.'));
  }

  $url = hosting_site_get_domain($params['new_uri']);
  if ($url == hosting_site_get_domain($site->title)) {
    form_set_error('parameters][new_uri', t('The upgraded copy needs a new domain name; the original site keeps serving at @domain.', array('@domain' => hosting_site_get_domain($site->title))));
  }
  else {
    if (!_hosting_valid_fqdn($url)) {
      form_set_error('parameters][new_uri', t('You have not specified a valid domain name.'));
    }
    if (!hosting_domain_allowed($url)) {
      form_set_error('parameters][new_uri', t('The domain name you have specified is not unique or not allowed.'));
    }
  }

  if (empty($params['target_platform'])) {
    form_set_error('parameters][target_platform', t('You must choose a verified Backdrop target platform.'));
  }
  elseif (!hosting_backdrop_platform_is_backdrop($params['target_platform'])) {
    form_set_error('parameters][target_platform', t('The chosen target platform is not a verified Backdrop platform.'));
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Creates the frontend node for the upgraded copy, mirroring the clone
 * post-task. Dark-by-design states are set EXPLICITLY (never inherited
 * defaults): SSL/LE disabled — a bespoke task inherits none of the
 * task-type-scoped auto-disable in the migrate/clone post-tasks — and cron
 * off, so a copy never emails or runs processes that confuse the live
 * site's users. import=1 makes the insert hook queue an import task (not
 * install); the import flips the node ENABLED once the backend context
 * reports the site installed.
 */
function hosting_backdrop_post_hosting_backdrop_upgrade_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  $target = $task->task_args['target_platform'];

  $upgrade = new stdClass();
  // Copy carry-over settings from the source node. Deliberately NOT copied:
  // profile (a D7 package id is wrong for the Backdrop copy — re-resolved
  // below), site_status (the queued import proves ENABLED honestly),
  // cron_interval and ssl_* (forced dark below).
  foreach (array('type', 'status', 'uid', 'comment', 'promote', 'moderate', 'sticky', 'name', 'format', 'client', 'db_server', 'site_language') as $field) {
    if (isset($task->ref->$field)) {
      $upgrade->$field = $task->ref->$field;
    }
  }
  $upgrade->title = hosting_site_clean_domain($task->task_args['new_uri']);
  $upgrade->hosting_name = hosting_site_get_domain($upgrade->title);
  $upgrade->platform = $target;
  $upgrade->import = 1;
  $upgrade->verified = 0;
  // The backend saved the new alias with aliases=array() and redirection=0.
  $upgrade->aliases = array();
  $upgrade->redirection = FALSE;

  if (isset($task->task_args['new_db_server']) && $task->task_args['new_db_server'] && $upgrade->db_server != $task->task_args['new_db_server']) {
    $upgrade->db_server = $task->task_args['new_db_server'];
  }

  // Resolve the profile by short_name on the TARGET platform only. The
  // old_short_name upgrade-path fallback is deliberately not used: relating
  // D7 names to Backdrop profile packages would surface Backdrop platforms
  // as stock-migrate targets. Unresolvable -> leave unset; the queued import
  // re-resolves from the backend context.
  if (isset($data['context']['profile'])) {
    $profile = hosting_package_instance_load(array(
      'i.rid' => $target,
      'p.short_name' => $data['context']['profile'],
    ));
    if ($profile) {
      $upgrade->profile = $profile->package_id;
    }
  }

  if (defined('HOSTING_SSL_DISABLED')) {
    $upgrade->ssl_enabled = HOSTING_SSL_DISABLED;
    $upgrade->ssl_key = 0;
    drush_log(dt('[backdrop-upgrade] Encryption explicitly disabled on the upgraded copy @uri', array('@uri' => $upgrade->title)), 'info');
  }
  if (defined('ADV_CRON_TURNED_OFF')) {
    $upgrade->cron_interval = ADV_CRON_TURNED_OFF;
  }

  node_save($upgrade);

  // Record the pre-upgrade backup taken on the source.
  $task->task_args['description'] = t('Pre-upgrade backup');
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Implements hook_hosting_TASK_OBJECT_context_options().
 *
 * For a site on a Backdrop platform, tell the backend to install through the
 * Backdrop path. The generic seam (hosting_site.drush.inc) only forwards an
 * install_method already present on the node; there is no persistent
 * install_method column, so derive it here from the platform's Backdrop marker.
 * Respect an install_method another module may already have set.
 */
function hosting_backdrop_hosting_site_context_options(&$task) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  if (!empty($task->context_options['install_method'])) {
    return;
  }
  if (isset($task->ref->platform) && hosting_backdrop_platform_is_backdrop($task->ref->platform)) {
    $task->context_options['install_method'] = HOSTING_BACKDROP_INSTALL_METHOD;
  }
}
