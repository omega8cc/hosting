<?php
/**
 * @file
 * Grav 2 platform support for the Aegir frontend.
 *
 * The frontend is version-agnostic: no node column records the CMS. The
 * backend (provision grav layer) reports the Grav signal on platform verify
 * as $data['grav'] = the Grav version string. This module stores that marker
 * per platform, then uses it to (a) keep Grav and Drupal platforms from being
 * offered together at site creation, (b) route Grav site installs through the
 * Grav path via context_options, (c) offer the supported upgrade procedures —
 * the mirror-fed core+bundle Upgrade in place, the Upgrade a copy migration
 * shape, and the Rename and Cutover primitives that finish it — and (d)
 * provide the 'none' db service type flat-file sites attach to
 * (a real, selectable db_server node whose context maps to
 * Provision_Service_null — boa-grav map par.1.3).
 *
 * PHP 5.6 floor: this file is loaded under the Drush-8 backend and must stay
 * 5.6-parseable (the D7 hostmaster floor, independent of the grav-layer
 * D-005 ruling).
 */

/**
 * Variable-name prefix for the per-platform Grav version marker.
 *
 * Keyed by platform nid; the value is the reported Grav version string.
 * Table-free storage (the {variable} table) keeps this a pure submodule with
 * no schema change to the shared hosting_platform table.
 */
define('HOSTING_GRAV_PLATFORM_VAR', 'hosting_grav_platform_version_');

/**
 * Variable-name prefix for the per-site Grav capsule version marker.
 *
 * Keyed by site nid; the value is the version the capsule itself reports on
 * its verify. A capsule is upgraded in place while the platform it was
 * created from keeps its seed version, so the platform marker describes the
 * capsule only until the first upgrade lands — this one always does. Same
 * table-free storage as the platform marker.
 */
define('HOSTING_GRAV_SITE_VAR', 'hosting_grav_site_version_');

/**
 * The install_method value the provision grav layer expects for Grav sites.
 */
define('HOSTING_GRAV_INSTALL_METHOD', 'grav');

/**
 * Determine whether a platform node is a verified Grav platform.
 *
 * @param int $platform_nid
 *   The platform node id.
 *
 * @return bool
 *   TRUE if the backend reported a Grav version for this platform.
 */
function hosting_grav_platform_is_grav($platform_nid) {
  if (empty($platform_nid)) {
    return FALSE;
  }
  $version = variable_get(HOSTING_GRAV_PLATFORM_VAR . $platform_nid, '');
  return $version !== '';
}

/**
 * Return the stored Grav version string for a platform, or ''.
 */
function hosting_grav_platform_version($platform_nid) {
  if (empty($platform_nid)) {
    return '';
  }
  return variable_get(HOSTING_GRAV_PLATFORM_VAR . $platform_nid, '');
}

/**
 * Implements hook_hosting_service().
 */
function hosting_grav_hosting_service() {
  return array(
    'none' => 'db',
  );
}

/**
 * Return every no-database server node on this panel, keyed by nid.
 *
 * hosting_get_servers('db') cannot answer this question: it returns every
 * server with an available db service whatever its TYPE, and it tags the
 * query with node_access — from drush or any non-web context that list can
 * come back empty for reasons that have nothing to do with the servers. So
 * this query is deliberately untagged, and joins on the CURRENT revision
 * (n.vid) so a service disabled in a newer revision stops counting.
 *
 * @param bool $reset
 *   TRUE to re-read after creating or changing a server in this request.
 *
 * @return array
 *   nid => title; empty when the panel has no 'none' server.
 */
function hosting_grav_none_db_servers($reset = FALSE) {
  $servers = &drupal_static(__FUNCTION__, NULL);
  if ($reset) {
    $servers = NULL;
  }
  if (is_array($servers)) {
    return $servers;
  }

  $servers = array();
  $query = db_select('node', 'n');
  $query->join('hosting_service', 's', 'n.vid = s.vid');
  $query
    ->fields('n', array('nid', 'title'))
    ->condition('n.type', 'server')
    ->condition('s.service', 'db')
    ->condition('s.type', 'none')
    ->condition('s.available', 1);
  $result = $query->execute();
  foreach ($result as $server) {
    $servers[$server->nid] = $server->title;
  }

  return $servers;
}

/**
 * Determine whether a db server node is a no-database ('none') server.
 */
function hosting_grav_db_server_is_none($nid) {
  if (empty($nid)) {
    return FALSE;
  }
  $servers = hosting_grav_none_db_servers();
  return isset($servers[$nid]);
}

/**
 * Create the no-database server node, once, if the panel has none.
 *
 * Flat-file capsules need a REAL db_server node to point at (db_server = 0
 * emits a hosting_context_name(0) error on every install and verify), and
 * the only way to get one is to create a server whose db service is of type
 * 'none'. Doing it by hand is a five-field form an operator has no reason to
 * know about, so the module that defines the service type also ships it.
 *
 * Idempotent by construction: it returns early when a 'none' server already
 * exists, which is what makes it safe from both hook_enable (first
 * enablement) and hook_update_N (panels that enabled the module before this
 * code existed).
 *
 * @return object|false
 *   The created server node, or FALSE when nothing was created.
 */
function hosting_grav_ensure_none_db_server() {
  // Without the service API the node would be saved with no db service at
  // all -- an unselectable server that looks like a bug. hosting_server is a
  // dependency of hosting itself, but enable order is not ours to assume.
  if (!function_exists('hosting_services_add') || !function_exists('_hosting_valid_fqdn_ip')) {
    return FALSE;
  }
  // A partial bootstrap (update.php, where hook_init never ran and the
  // hosting constants do not exist) cannot save a node: the node-access
  // hooks die on the missing constants. Leave it to a full request.
  if (!defined('HOSTING_DEFAULT_DB_SERVER')) {
    return FALSE;
  }
  if (hosting_grav_none_db_servers(TRUE)) {
    return FALSE;
  }

  // A server title must be hostname-shaped (hosting_server_validate() runs
  // _hosting_valid_fqdn_ip on it), so name the server after the panel.
  $host = '';
  if (function_exists('hosting_get_hostmaster_site_nid')) {
    $hostmaster_nid = hosting_get_hostmaster_site_nid();
    if (!empty($hostmaster_nid)) {
      $hostmaster = node_load($hostmaster_nid);
      if (is_object($hostmaster) && !empty($hostmaster->title)) {
        $host = $hostmaster->title;
      }
    }
  }
  if ($host === '') {
    $host = php_uname('n');
  }
  $title = 'none.' . drupal_strtolower(trim($host));
  if (!_hosting_valid_fqdn_ip($title)) {
    drupal_set_message(t('Hosting Grav could not derive a valid hostname for the "None (flat-file sites)" database server (tried @title). Add the server by hand, with its database service set to the "None" type, before creating Grav sites.', array('@title' => $title)), 'warning');
    return FALSE;
  }

  $node = new stdClass();
  $node->type = 'server';
  node_object_prepare($node);
  $node->uid = 1;
  $node->status = 1;
  $node->title = $title;
  $node->human_name = 'None (flat-file sites)';
  // hosting_services_add(), never a bare hosting_services_new_object(): only
  // this path sets available, and a service with available = 0 makes the
  // server invisible to hosting_get_servers('db') -- that is, unselectable
  // everywhere, which is exactly the failure this function exists to avoid.
  hosting_services_add($node, 'db', 'none', array('available' => 1));
  node_save($node);
  hosting_grav_none_db_servers(TRUE);

  drupal_set_message(t('Hosting Grav created the "None (flat-file sites)" database server @title for flat-file site capsules.', array('@title' => $node->title)));

  return $node;
}

/**
 * Implements hook_init().
 *
 * The one deferred job: create the no-database server that an update hook
 * asked for (it cannot save nodes itself). One cached variable read per
 * request while nothing is pending; the flag is cleared on the first full
 * request that manages to create the server, or finds one.
 */
function hosting_grav_init() {
  if (!variable_get('hosting_grav_none_server_wanted', 0)) {
    return;
  }
  if (hosting_grav_none_db_servers(TRUE) || hosting_grav_ensure_none_db_server()) {
    variable_del('hosting_grav_none_server_wanted');
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Stores (or clears) the Grav version markers from the verify result.
 *
 * Platform: the grav layer's platform verify adds $data['grav'] = the Grav
 * version string alongside the standard packages/profiles/sites keys.
 * Presence of that key is the Grav signal.
 *
 * Site: the capsule carries its OWN version — it is upgraded in place while
 * the platform keeps its seed version — and the site verify reports it in the
 * site package map, which the grav layer builds from the capsule path:
 * $packages['base']['platforms']['grav']['version']. Recording it per site
 * nid is what lets the dialogs name the capsule's version rather than the
 * platform's, which is wrong on every capsule upgraded at least once.
 */
function hosting_grav_post_hosting_verify_task($task, $data) {
  if (!isset($task->ref)) {
    return;
  }
  if ($task->ref->type == 'site') {
    $name = HOSTING_GRAV_SITE_VAR . $task->ref->nid;
    $version = '';
    if (isset($data['context']['packages']['base']['platforms']['grav']['version'])
      && is_string($data['context']['packages']['base']['platforms']['grav']['version'])) {
      $version = trim($data['context']['packages']['base']['platforms']['grav']['version']);
    }
    if ($version !== '') {
      // Only write on change to avoid needless variable-cache invalidation.
      if (variable_get($name, '') !== $version) {
        variable_set($name, $version);
      }
    }
    elseif (variable_get($name, NULL) !== NULL) {
      // A non-Grav site reports no such map: drop any stale marker. Guarded
      // so an ordinary Drupal verify never clears the bootstrap cache.
      variable_del($name);
    }
    return;
  }
  if ($task->ref->type != 'platform') {
    return;
  }
  $name = HOSTING_GRAV_PLATFORM_VAR . $task->ref->nid;

  // Read the reported version; tolerate it arriving nested under 'context'.
  $version = '';
  if (isset($data['grav']) && is_string($data['grav'])) {
    $version = trim($data['grav']);
  }
  elseif (isset($data['context']['grav']) && is_string($data['context']['grav'])) {
    $version = trim($data['context']['grav']);
  }

  if ($version !== '') {
    // Only write on change to avoid needless variable-cache invalidation.
    if (variable_get($name, '') !== $version) {
      variable_set($name, $version);
    }
  }
  else {
    // Re-verified as a non-Grav platform: drop any stale marker. Guard the
    // delete so a normal Drupal verify never clears the bootstrap cache.
    if (variable_get($name, NULL) !== NULL) {
      variable_del($name);
    }
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * The upgrade takes a safety copy of the capsule before touching it; record
 * it the way the clone records its pre-clone copy, so it appears on the
 * site's backups list (restorable, deletable) instead of sitting on disk
 * unregistered until the retention sweep.
 *
 * The capsule now carries a different version, and only a frontend verify
 * refreshes the marker the dialogs read (the backend's own post-command
 * verify is a separate process whose package map never reaches the front
 * end). Queue one; hosting_add_task() folds it into a verify already waiting
 * for the site.
 */
function hosting_grav_post_hosting_grav_upgrade_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  hosting_add_task($task->ref->nid, 'verify');

  if (empty($data['context']['backup_file']) || !function_exists('hosting_site_post_hosting_backup_task')) {
    return;
  }
  $task->task_args['description'] = t('Pre-upgrade backup');
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Creates the frontend node for the upgraded copy, mirroring the clone
 * post-task. Dark-by-design states are set EXPLICITLY (never inherited
 * defaults): encryption disabled — a bespoke task inherits none of the
 * task-type-scoped auto-disable in the migrate/clone post-tasks — and cron
 * off, so a copy never runs processes that confuse the live site's users.
 * import=1 makes the insert hook queue an import task (not install); the
 * import flips the node ENABLED once the backend context reports the site
 * installed.
 */
function hosting_grav_post_hosting_grav_copy_upgrade_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  $target = $task->task_args['target_platform'];

  // A platform verify running concurrently (the queue forks tasks) can
  // discover the freshly built capsule and adopt it before this hook runs;
  // inserting a second node would then fail on the duplicate context and
  // mark an otherwise fully successful upgrade Failed. Keep the adopted node
  // and only record the backup.
  $existing = hosting_get_site_by_url(hosting_site_get_domain($task->task_args['new_uri']), FALSE);
  if ($existing) {
    drush_log(dt('[grav-copy-upgrade] The upgraded copy @uri was already registered as node @nid (adopted by a platform verify); keeping it.',
      array('@uri' => $task->task_args['new_uri'], '@nid' => $existing)), 'ok');
    $task->task_args['description'] = t('Pre-upgrade backup');
    hosting_site_post_hosting_backup_task($task, $data);
    return;
  }

  $upgrade = new stdClass();
  // Copy carry-over settings from the source node. Deliberately NOT copied:
  // profile (re-resolved on the target below), site_status (the queued import
  // proves ENABLED honestly), cron_interval and ssl_* (forced dark below).
  // db_server IS carried: a Grav capsule has no database and keeps the
  // source's no-database server, which the pre-task hook has already pinned
  // in task_args.
  foreach (array('type', 'status', 'uid', 'comment', 'promote', 'moderate', 'sticky', 'name', 'format', 'client', 'db_server', 'site_language') as $field) {
    if (isset($task->ref->$field)) {
      $upgrade->$field = $task->ref->$field;
    }
  }
  $upgrade->title = hosting_site_clean_domain($task->task_args['new_uri']);
  $upgrade->hosting_name = hosting_site_get_domain($upgrade->title);
  $upgrade->platform = $target;
  $upgrade->import = 1;
  $upgrade->verified = 0;
  // The backend saved the new context with aliases=array() and redirection=0.
  $upgrade->aliases = array();
  $upgrade->redirection = FALSE;

  // Resolve the profile on the TARGET platform. A Grav platform reports the
  // single synthetic 'grav' profile; the backend's own value is preferred
  // when it reported one. Unresolvable -> leave unset; the queued import
  // re-resolves it from the backend context.
  $short_name = 'grav';
  if (!empty($data['context']['profile']) && is_string($data['context']['profile'])) {
    $short_name = $data['context']['profile'];
  }
  $profile = hosting_package_instance_load(array(
    'i.rid' => $target,
    'p.short_name' => $short_name,
  ));
  if ($profile) {
    $upgrade->profile = $profile->package_id;
  }

  if (defined('HOSTING_SSL_DISABLED')) {
    $upgrade->ssl_enabled = HOSTING_SSL_DISABLED;
    $upgrade->ssl_key = 0;
    drush_log(dt('[grav-copy-upgrade] Encryption explicitly disabled on the upgraded copy @uri', array('@uri' => $upgrade->title)), 'advisory');
  }
  if (defined('ADV_CRON_TURNED_OFF')) {
    $upgrade->cron_interval = ADV_CRON_TURNED_OFF;
  }

  node_save($upgrade);

  // Record the pre-upgrade backup taken on the source.
  $task->task_args['description'] = t('Pre-upgrade backup');
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * The rename bookkeeping subset of the migrate post-task: the site keeps its
 * node, so the node has to follow the backend — retitle, re-register the
 * hosting context under the new name, disable encryption (keys are
 * name-bound) and queue the verify that renders the new vhost state into the
 * frontend. The alias set is emptied because the backend saved the new
 * context that way; anything else would have the next verify push aliases
 * the renamed capsule does not serve.
 */
function hosting_grav_post_hosting_grav_rename_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  $site = $task->ref;
  $new_uri = isset($task->task_args['new_uri']) ? $task->task_args['new_uri'] : '';

  if ($new_uri !== '' && hosting_site_get_domain($site->title) != hosting_site_get_domain($new_uri)) {
    $site->title = hosting_site_clean_domain($new_uri);
    hosting_context_register($site->nid, hosting_site_get_domain($site->title));

    if (defined('HOSTING_SSL_DISABLED') && !empty($site->ssl_enabled)
      && !(function_exists('hosting_get_hostmaster_nid') && $site->nid == hosting_get_hostmaster_nid())) {
      $site->ssl_enabled = HOSTING_SSL_DISABLED;
      $site->ssl_key = 0;
      drush_log(dt('[grav-rename] Encryption disabled for the new name @uri; re-enable it deliberately once the rename is verified.', array('@uri' => $site->title)), 'advisory');
    }

    $site->aliases = array();
    $site->redirection = FALSE;
    $site->verified = REQUEST_TIME;
    $site->no_verify = TRUE;
    node_save($site);
    $task->ref = $site;

    // Refresh the vhost and the site's recorded state under the new name.
    hosting_add_task($site->nid, 'verify');
  }

  // Record the safety copy taken before the rename.
  $task->task_args['description'] = t('Pre-rename backup');
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Register the safety copy a task took, from either of its two exits.
 *
 * Every task in this family takes an archive of the site before it touches
 * anything, and the archive is only reachable through the Restore task once
 * it has a row on the site. The post-task hooks do that on the success exit;
 * a task that errored never reaches them — Drush leaves the hook chain the
 * moment the backend propagates an error and takes the rollback exit instead
 * — which is precisely the exit on which the archive is the recovery. The
 * rollback hooks below therefore register it too, so the operator is never
 * sent to a Backups tab that has no such row. The archive path and its size
 * are set by the backup the pre-hook ran, so both keys are in the backend
 * output on both exits.
 *
 * @param object $task
 *   The task node, carrying its ref and task_args.
 * @param array $data
 *   The backend output.
 * @param string $description
 *   The description the backup row is listed under.
 */
function _hosting_grav_register_safety_copy($task, $data, $description) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  if (empty($data['context']['backup_file']) || !function_exists('hosting_site_post_hosting_backup_task')) {
    return;
  }
  $task->task_args['description'] = $description;
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Implements hook_hosting_TASK_TYPE_task_rollback().
 */
function hosting_grav_hosting_grav_upgrade_task_rollback($task, $data) {
  _hosting_grav_register_safety_copy($task, $data, t('Pre-upgrade backup'));
}

/**
 * Implements hook_hosting_TASK_TYPE_task_rollback().
 */
function hosting_grav_hosting_grav_copy_upgrade_task_rollback($task, $data) {
  _hosting_grav_register_safety_copy($task, $data, t('Pre-upgrade backup'));
}

/**
 * Implements hook_hosting_TASK_TYPE_task_rollback().
 */
function hosting_grav_hosting_grav_rename_task_rollback($task, $data) {
  _hosting_grav_register_safety_copy($task, $data, t('Pre-rename backup'));
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Cleans up the version marker when a platform or a site is deleted, so a
 * recycled nid never inherits the previous node's version.
 */
function hosting_grav_post_hosting_delete_task($task, $data) {
  if (!isset($task->ref)) {
    return;
  }
  $name = '';
  if ($task->ref->type == 'platform') {
    $name = HOSTING_GRAV_PLATFORM_VAR . $task->ref->nid;
  }
  elseif ($task->ref->type == 'site') {
    $name = HOSTING_GRAV_SITE_VAR . $task->ref->nid;
  }
  if ($name !== '' && variable_get($name, NULL) !== NULL) {
    variable_del($name);
  }
}

/**
 * Implements hook_hosting_site_options_alter().
 *
 * Partition the platform options so Grav and non-Grav platforms are never
 * offered together (the distinct synthetic 'grav' profile already keeps the
 * lists apart on the create form; this is the belt covering migrate/clone
 * option paths, symmetric in both directions — the hosting_backdrop shape).
 */
function hosting_grav_hosting_site_options_alter(&$return, &$node) {
  if (empty($return['platform']) || !is_array($return['platform'])) {
    return;
  }

  $reference = isset($node->platform) ? $node->platform : reset($return['platform']);
  if (empty($reference)) {
    return;
  }
  $reference_is_grav = hosting_grav_platform_is_grav($reference);

  $filtered = array();
  foreach ($return['platform'] as $nid) {
    if (hosting_grav_platform_is_grav($nid) == $reference_is_grav) {
      $filtered[] = $nid;
    }
  }

  // Never present an empty platform list; only apply a non-empty partition.
  if (!empty($filtered)) {
    $return['platform'] = $filtered;
  }
}

/**
 * Implements hook_permission().
 *
 * The "create TASK_TYPE task" permission string is load-bearing:
 * hosting_task_menu_access() gates both the Run button and the confirm path
 * on user_access("create grav_upgrade task").
 */
function hosting_grav_permission() {
  return array(
    'create grav_upgrade task' => array(
      'title' => t('create grav_upgrade task'),
    ),
    'create grav_copy_upgrade task' => array(
      'title' => t('create grav_copy_upgrade task'),
    ),
    'create grav_rename task' => array(
      'title' => t('create grav_rename task'),
    ),
    'create grav_cutover task' => array(
      'title' => t('create grav_cutover task'),
    ),
  );
}

/**
 * Implements hook_hosting_tasks().
 *
 * The 'command' key is mandatory on every one of these: the default derivation
 * would yield provision-grav_upgrade (underscore), which does not exist.
 *
 * Four tasks, all per-SITE by design (capsules upgrade independently):
 *  - grav_upgrade      in place, on the live capsule, from the staged artefact
 *  - grav_copy_upgrade the migration shape -- a copy at a NEW domain, upgraded
 *  - grav_rename       the same-platform rename primitive
 *  - grav_cutover      the deliberate final step: take over the old domain
 *
 * Cutover chains grav_rename (and a delete of the domain's current holder)
 * as REAL frontend tasks, so there is deliberately no post-task hook for it
 * here: each chained task carries its own, and the node bookkeeping happens
 * there rather than twice.
 */
function hosting_grav_hosting_tasks() {
  $tasks = array();

  $tasks['site']['grav_upgrade'] = array(
    'title' => t('Upgrade Grav'),
    'description' => t('Upgrade this site capsule to the newest staged official Grav release (core + admin bundle, fetched from our mirrors — never a third-party download on this box). A safety backup is taken first; user content, accounts and configuration survive the upgrade in place.'),
    'command' => 'provision-grav-upgrade',
    'access callback' => 'hosting_grav_upgrade_task_access',
    // A dialog, like every sibling task: the confirm form's token is the
    // CSRF check. The custom access callback above replaces the menu item's
    // token-checking one, and without a dialog a plain GET on the confirm
    // path queued the task.
    'dialog' => TRUE,
  );

  $tasks['site']['grav_copy_upgrade'] = array(
    'title' => t('Upgrade a copy'),
    'description' => t('Copy this site capsule onto a Grav platform at a NEW domain name and upgrade the copy to the newest staged official release. The original site keeps serving at its current domain throughout — its capsule is never opened for writing; test the copy, then take the original domain over with Cutover. The copy keeps the original\'s content, accounts, configuration, security keys and outstanding tokens: it is the same site under a temporary name, not an independent publication, until Cutover. It starts with encryption switched off.'),
    'command' => 'provision-grav-copy-upgrade',
    'access callback' => 'hosting_grav_copy_upgrade_task_access',
    'dialog' => TRUE,
  );

  $tasks['site']['grav_rename'] = array(
    'title' => t('Rename'),
    'description' => t('Move this site capsule to a new domain name on the same platform. A safety backup is taken first. The old domain stops serving as soon as the rename completes; custom aliases are not carried over, and encryption ends up disabled for the new name (certificates are name-bound) — re-enable it deliberately afterwards.'),
    'command' => 'provision-grav-rename',
    'access callback' => 'hosting_grav_rename_task_access',
    'dialog' => TRUE,
  );

  $tasks['site']['grav_cutover'] = array(
    'title' => t('Cutover'),
    'description' => t('Make this site answer at a domain currently held by another site — typically the original domain of the site it was upgraded from. The site holding that domain is backed up and then deleted; this site is then renamed to the freed domain. Encryption ends up disabled for the new name (certificates are name-bound) — re-enable it deliberately afterwards. The domain is unserved while the rename completes: minutes that scale with the size of this site.'),
    'command' => 'provision-grav-cutover',
    'access callback' => 'hosting_grav_cutover_task_access',
    'dialog' => TRUE,
  );

  return $tasks;
}

/**
 * Access callback for the grav_upgrade task.
 *
 * Same two-context posture as the hosting_backdrop callbacks (button render +
 * hosting_confirm menu item; must not require the URL token — none exists at
 * button-render time). Only an ENABLED site on a marker-verified Grav
 * platform gets the button.
 */
function hosting_grav_upgrade_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Return the Grav version this site capsule reports, or ''.
 *
 * A capsule carries its OWN version -- capsules are upgraded independently of
 * the platform they were created from -- and the site verify reports it as the
 * site package map. The per-site marker written from that map is therefore
 * the authoritative value and is read first.
 *
 * The package instance row is the older route and is kept as a second chance:
 * Grav's site map carries no versioned plural group, so that row normally
 * reads 'Unknown' and only a value that looks like a version is taken from
 * it. The platform marker is the last fallback, correct on a capsule never
 * upgraded and only ever used to word one sentence: the backend reads the
 * capsule itself and refuses an artefact that is not newer.
 */
function _hosting_grav_site_version($node) {
  if (!is_object($node) || empty($node->nid)) {
    return '';
  }
  $capsule = variable_get(HOSTING_GRAV_SITE_VAR . $node->nid, '');
  if ($capsule !== '') {
    return $capsule;
  }
  if (function_exists('hosting_package_instance_load')) {
    $instance = hosting_package_instance_load(array(
      'i.rid' => $node->nid,
      'p.short_name' => 'grav',
    ));
    if (is_object($instance) && !empty($instance->version)
      && preg_match('/^[0-9]/', $instance->version)) {
      return $instance->version;
    }
  }
  if (isset($node->platform)) {
    return hosting_grav_platform_version($node->platform);
  }
  return '';
}

/**
 * Implements the grav_upgrade task confirmation form.
 *
 * The in-place upgrade takes no arguments -- the artefact is resolved
 * backend-side from the mirror-fed staging directory. The dialog exists for
 * its CSRF token; this item makes it say what the operator is about to
 * install over.
 */
function hosting_task_grav_upgrade_form($node) {
  $form = array();

  $version = _hosting_grav_site_version($node);
  $form['current_version'] = array(
    '#type' => 'item',
    '#title' => t('Version'),
    '#markup' => $version !== ''
      ? t('This capsule runs Grav @version. The upgrade installs the newest staged official release held on this server, over the capsule in place, and refuses when nothing newer than the capsule is staged.', array('@version' => $version))
      : t('The version of this capsule is not recorded yet — run a Verify task on the site to record it. The upgrade installs the newest staged official release held on this server, over the capsule in place, and refuses when nothing newer than the capsule is staged.'),
  );

  $form['#node'] = $node;
  return $form;
}

/**
 * Return the available copy-upgrade targets: verified Grav platforms.
 *
 * Marker presence already implies a verified, non-deleted Grav platform (the
 * marker is written on platform verify and cleared on delete);
 * _hosting_get_platforms(0, TRUE) additionally drops locked ones. The site's
 * own platform stays in the list: a capsule is self-contained, so upgrading a
 * copy on the same platform is an ordinary choice. Titles are check_plain()ed
 * for direct use as radio option labels.
 */
function _hosting_grav_copy_upgrade_targets() {
  $targets = array();
  foreach (_hosting_get_platforms(0, TRUE) as $nid => $title) {
    if (hosting_grav_platform_is_grav($nid)) {
      $targets[$nid] = check_plain($title);
    }
  }
  return $targets;
}

/**
 * Pick the default copy-upgrade target: the highest reported version string.
 *
 * version_compare on the marker STRING, never version_code: the code drops
 * the patch level, which is exactly what separates two Grav platforms. A
 * platform with no readable version never displaces one that has.
 */
function _hosting_grav_copy_upgrade_default_target($targets) {
  $best = NULL;
  $best_version = '';
  foreach (array_keys($targets) as $nid) {
    $version = hosting_grav_platform_version($nid);
    if (is_null($best)) {
      $best = $nid;
      $best_version = $version;
      continue;
    }
    if ($version === '') {
      continue;
    }
    if ($best_version === '' || version_compare($version, $best_version, '>')) {
      $best = $nid;
      $best_version = $version;
    }
  }
  return $best;
}

/**
 * Access callback for the grav_copy_upgrade task.
 *
 * Same two-context posture as hosting_grav_upgrade_task_access (button render
 * + the hosting_confirm menu item; no URL token exists at button-render
 * time). An ENABLED site on a marker-verified Grav platform, and at least one
 * verified Grav platform to put the copy on -- offering a dead-end form is
 * worse than no button.
 */
function hosting_grav_copy_upgrade_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  if (!count(_hosting_grav_copy_upgrade_targets())) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements the grav_copy_upgrade task confirmation form.
 */
function hosting_task_grav_copy_upgrade_form($node) {
  $form = array();

  $form['new_uri'] = array(
    '#type' => 'textfield',
    '#title' => t('New domain name'),
    '#description' => t('The upgraded copy is created at this new domain. The original site keeps serving at its current domain until you switch over deliberately.'),
    '#required' => TRUE,
    '#weight' => -1,
  );

  // Marker-verified Grav targets only. The access callback already hides the
  // task when this list is empty; the no-target branch is defence in depth
  // for a direct request racing a platform lock or delete.
  $targets = _hosting_grav_copy_upgrade_targets();
  if (count($targets)) {
    $form['target_platform'] = array(
      '#type' => 'radios',
      '#title' => t('Target Grav platform'),
      '#required' => TRUE,
      '#options' => $targets,
      '#default_value' => _hosting_grav_copy_upgrade_default_target($targets),
    );
  }
  else {
    $form['no_target'] = array(
      '#type' => 'item',
      '#title' => t('Target Grav platform'),
      '#markup' => t('No verified Grav platform is available. Add a Grav platform and verify it first.'),
    );
  }

  // A Grav capsule carries no database, so the copy keeps the source's
  // no-database server whatever anyone asks for. The element has to stay
  // PRESENT: the pre-task hook and the post-task handler both read
  // task_args['new_db_server'], and dropping it turns every copy upgrade
  // into a notice and a wrong comparison. The shared confirm-form alter pins
  // it again for this task and adds the crafted-post validation belt.
  $form['new_db_server'] = array(
    '#type' => 'value',
    '#value' => isset($node->db_server) ? $node->db_server : 0,
  );

  $form['copy_report'] = array(
    '#type' => 'item',
    '#title' => t('What happens'),
    '#markup' => t('The copy is built from a safety backup of this capsule, upgraded on the target platform to the newest staged official release, and verified. It answers at the new domain; this site keeps answering at its own, and its capsule is never opened for writing. The copy keeps the original\'s content, accounts, configuration, security keys and outstanding tokens — it is the same site under a temporary name, not an independent publication, until Cutover — and starts with encryption switched off and cron disabled.'),
  );

  $form['#node'] = $node;
  return $form;
}

/**
 * Validation for the grav_copy_upgrade task confirmation form.
 *
 * The backend validate re-checks everything fail-closed (Grav on both sides,
 * free URI, a staged artefact newer than the capsule); this front check
 * exists so operator mistakes surface in the form, not minutes later in a red
 * task log.
 */
function hosting_task_grav_copy_upgrade_form_validate($form, &$form_state) {
  $site = $form['parameters']['#node'];
  $params = $form_state['values']['parameters'];

  if (!isset($site->platform) || !hosting_grav_platform_is_grav($site->platform)) {
    form_set_error('parameters][target_platform', t('This site does not run on a verified Grav platform.'));
  }

  $url = hosting_site_get_domain($params['new_uri']);
  if ($url == hosting_site_get_domain($site->title)) {
    form_set_error('parameters][new_uri', t('The upgraded copy needs a new domain name; the original site keeps serving at @domain.', array('@domain' => hosting_site_get_domain($site->title))));
  }
  else {
    if (!_hosting_valid_fqdn($url)) {
      form_set_error('parameters][new_uri', t('You have not specified a valid domain name.'));
    }
    if (!hosting_domain_allowed($url)) {
      form_set_error('parameters][new_uri', t('The domain name you have specified is not unique or not allowed.'));
    }
  }

  if (empty($params['target_platform'])) {
    form_set_error('parameters][target_platform', t('You must choose a verified Grav target platform.'));
  }
  elseif (!hosting_grav_platform_is_grav($params['target_platform'])) {
    form_set_error('parameters][target_platform', t('The chosen target platform is not a verified Grav platform.'));
  }
}

/**
 * Access callback for the grav_rename task.
 *
 * Same two-context posture (no URL token). Only an ENABLED site on a
 * marker-verified Grav platform: renaming a disabled or not-yet-imported
 * capsule is a dead end, and the backend refuses it.
 */
function hosting_grav_rename_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements the grav_rename task confirmation form.
 */
function hosting_task_grav_rename_form($node) {
  $form = array();

  $form['new_uri'] = array(
    '#type' => 'textfield',
    '#title' => t('New domain name'),
    '#description' => t('The capsule keeps its content, accounts and configuration and answers at this name instead, on the same platform.'),
    '#required' => TRUE,
    '#weight' => -1,
    // The site's own primary name, never the redirection target: the
    // migrate dialog's reasoning applies here too.
    '#default_value' => hosting_site_clean_domain($node->title),
  );

  $form['rename_report'] = array(
    '#type' => 'item',
    '#title' => t('What happens'),
    '#markup' => t('A safety backup is taken first. The capsule moves to the new name, the old vhost is removed and the new one rendered, so the old domain stops serving as soon as the rename completes. Custom aliases are not carried over, and encryption ends up disabled for the new name (certificates are name-bound) — re-enable it deliberately afterwards.'),
  );

  $form['#node'] = $node;
  return $form;
}

/**
 * Validation for the grav_rename task confirmation form.
 */
function hosting_task_grav_rename_form_validate($form, &$form_state) {
  $site = $form['parameters']['#node'];
  $params = $form_state['values']['parameters'];

  if (!isset($site->platform) || !hosting_grav_platform_is_grav($site->platform)) {
    form_set_error('parameters][new_uri', t('This site does not run on a verified Grav platform.'));
    return;
  }

  $url = hosting_site_get_domain($params['new_uri']);
  if ($url == hosting_site_get_domain($site->title)) {
    form_set_error('parameters][new_uri', t('Renaming needs a domain name different from @domain.', array('@domain' => hosting_site_get_domain($site->title))));
    return;
  }
  if (!_hosting_valid_fqdn($url)) {
    form_set_error('parameters][new_uri', t('You have not specified a valid domain name.'));
    return;
  }
  // Deliberately without the migrate validator's www/non-www companion
  // tolerance: this rename saves the new context with an EMPTY alias set, so
  // an alias equal to the new name is a genuine conflict — remove it from
  // the site first.
  if (!hosting_domain_allowed($url)) {
    form_set_error('parameters][new_uri', t('The domain name you have specified is not unique or not allowed.'));
  }
}

/**
 * Access callback for the grav_cutover task.
 *
 * Same two-context posture (no URL token). Only an ENABLED site on a
 * marker-verified Grav platform can take a domain over this way: the chain
 * ends in the Grav rename leg, and renaming a disabled or not-yet-imported
 * copy is a dead end (the import after a copy upgrade enables the copy).
 */
function hosting_grav_cutover_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements the grav_cutover task confirmation form.
 */
function hosting_task_grav_cutover_form($node) {
  $form = array();

  $form['target_domain'] = array(
    '#type' => 'textfield',
    '#title' => t('Domain to take over'),
    '#description' => t('Usually the original domain of the site this copy was upgraded from. The site currently at that domain is backed up and then deleted; this site is renamed to it. If no site holds the domain (for example after a previous cutover attempt), the rename runs alone.'),
    '#required' => TRUE,
    '#weight' => -1,
  );

  $form['cutover_report'] = array(
    '#type' => 'item',
    '#title' => t('What happens'),
    '#markup' => t('The current holder of the domain is re-checked when the task runs; its full backup is taken by the delete step and stays restorable. Encryption ends up disabled for the new name (certificates are name-bound) — re-enable it on this site afterwards. Custom aliases of the old site are not carried over. The domain is unserved while the rename completes: minutes that scale with the size of this site.'),
  );

  $form['#node'] = $node;
  return $form;
}

/**
 * Whether an account may retire the site node a cutover would take over.
 *
 * Cutover backs up and DELETES the site holding the target domain, so the
 * account queueing it has to be allowed to administer that node. Without this
 * test the task permission alone lets anyone who may cut over one site
 * destroy ANY other site on the panel, including another account's: the
 * holder is resolved by hosting_get_site_by_url(), a query carrying no
 * node-access tag, and the task access callbacks only ever look at the node
 * the task is queued ON.
 *
 * 'update' is accepted beside 'delete' deliberately. With the client feature
 * enabled every site grant row is written with grant_delete = 0
 * (hosting_client_node_access_records()) and the site hook returns
 * NODE_ACCESS_IGNORE, so a 'delete' test alone refuses the panel's own
 * administrators as well as the owner. 'update' is the strongest grant a site
 * node carries there, and it is exactly what separates a site the account
 * administers from a stranger's.
 *
 * @param object $holder
 *   The loaded site node holding the target domain.
 * @param object $account
 *   The account the task is queued as.
 *
 * @return bool
 *   TRUE when the account may retire the holder.
 */
function _hosting_grav_may_retire_site($holder, $account) {
  if (!is_object($holder) || !is_object($account)) {
    return FALSE;
  }
  return node_access('delete', $holder, $account) || node_access('update', $holder, $account);
}

/**
 * Validation for the grav_cutover task confirmation form.
 *
 * The pre-task drush hook re-resolves the domain holder at execution time and
 * the backend validates fail-closed; this front check exists so operator
 * mistakes surface in the form, not minutes later in a red task log.
 */
function hosting_task_grav_cutover_form_validate($form, &$form_state) {
  global $user;
  $site = $form['parameters']['#node'];
  $params = $form_state['values']['parameters'];

  $url = hosting_site_get_domain($params['target_domain']);
  if (!_hosting_valid_fqdn($url)) {
    form_set_error('parameters][target_domain', t('You have not specified a valid domain name.'));
    return;
  }
  if ($url == hosting_site_get_domain($site->title)) {
    form_set_error('parameters][target_domain', t('This site already answers at @domain.', array('@domain' => $url)));
    return;
  }

  $holder = hosting_get_site_by_url($url);
  if (is_object($holder)) {
    if ($holder->nid == $site->nid) {
      form_set_error('parameters][target_domain', t('@domain already belongs to this site (as an alias). Remove that alias from the site, then use Rename to make @domain its main domain.', array('@domain' => $url)));
    }
    elseif ($holder->nid == hosting_get_hostmaster_site_nid()) {
      form_set_error('parameters][target_domain', t('@domain is the hosting front-end; it cannot be taken over.', array('@domain' => $url)));
    }
    elseif (hosting_site_get_domain($holder->title) != $url) {
      form_set_error('parameters][target_domain', t('@domain is an alias of @site, not its main domain. Remove the alias there, or cut over to the main domain instead.', array('@domain' => $url, '@site' => hosting_site_get_domain($holder->title))));
    }
    elseif (!hosting_task_dangerous_task_is_allowed('delete', $holder->nid)) {
      form_set_error('parameters][target_domain', t('@site is guarded against deletion; cutover would need to delete it.', array('@site' => hosting_site_get_domain($holder->title))));
    }
    elseif (!_hosting_grav_may_retire_site($holder, $user)) {
      form_set_error('parameters][target_domain', t('You may not retire @site, and cutover would delete it.', array('@site' => hosting_site_get_domain($holder->title))));
    }
  }
  else {
    // Nobody holds the domain: cutover degrades to a plain rename, but the
    // name must still be allowed (not held by a non-site record).
    if (!hosting_domain_allowed($url)) {
      form_set_error('parameters][target_domain', t('No site holds @domain but the name is not allowed.', array('@domain' => $url)));
    }
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Badge Grav platforms and their sites in the admin theme: a small
 * title-suffix label plus node classes (platform-grav / site-grav) the eldir
 * theme can style. A theme without the CSS just shows the plain label.
 */
function hosting_grav_preprocess_node(&$variables) {
  if (empty($variables['node']) || !is_object($variables['node'])) {
    return;
  }
  $node = $variables['node'];
  $version = '';
  $class = '';
  if ($node->type == 'platform' && hosting_grav_platform_is_grav($node->nid)) {
    $version = hosting_grav_platform_version($node->nid);
    $class = 'platform-grav';
  }
  elseif ($node->type == 'site' && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    $version = hosting_grav_platform_version($node->platform);
    $class = 'site-grav';
  }
  if ($class === '') {
    return;
  }
  $variables['classes_array'][] = $class;
  $label = $version !== '' ? t('Grav @version', array('@version' => $version)) : t('Grav');
  $variables['title_suffix']['grav_badge'] = array(
    '#markup' => ' <span class="grav-badge">' . $label . '</span>',
  );
}

/**
 * Implements hook_hosting_TASK_OBJECT_context_options().
 *
 * For a site on a Grav platform, tell the backend to install through the Grav
 * path. The generic seam (hosting_site.drush.inc) only forwards an
 * install_method already present on the node; there is no persistent
 * install_method column, so derive it here from the platform's Grav marker.
 * Respect an install_method another module may already have set.
 */
function hosting_grav_hosting_site_context_options(&$task) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  if (!empty($task->context_options['install_method'])) {
    return;
  }
  if (isset($task->ref->platform) && hosting_grav_platform_is_grav($task->ref->platform)) {
    $task->context_options['install_method'] = HOSTING_GRAV_INSTALL_METHOD;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * The clone, migrate and Grav copy-upgrade dialogs ask which DATABASE SERVER
 * the copy should use (hosting_task_migrate_form(), reused verbatim by
 * hosting_task_clone_form()) and they offer every server that has an
 * available db service. On a panel that carries both a MySQL server and the
 * flat-file 'none' server, that control is a REQUIRED choice between two
 * wrong answers: it lets an operator attach a DB-less Grav capsule to MySQL,
 * or a Drupal site to the no-database server. The backend refuses a Grav
 * clone or restore whose site is attached to a real database server, so the
 * front end must not offer it in the first place.
 */
function hosting_grav_form_hosting_task_confirm_form_alter(&$form, &$form_state) {
  if (!isset($form['task']['#value'])) {
    return;
  }
  $task = $form['task']['#value'];
  if (!isset($form['parameters']['new_db_server'])) {
    return;
  }
  // The site node rides into the confirm form on the dialogs that offer a
  // db server (hosting_task_migrate_form() sets $form['#node'], merged in
  // under 'parameters'; the Backdrop upgrade dialogs do the same); the menu
  // callback's node is the fallback.
  $node = NULL;
  if (isset($form['parameters']['#node']) && is_object($form['parameters']['#node'])) {
    $node = $form['parameters']['#node'];
  }
  elseif (isset($form['nid']['#value'])) {
    $node = node_load($form['nid']['#value']);
  }
  if (!is_object($node) || !isset($node->type) || $node->type != 'site') {
    return;
  }

  if (($task == 'clone' || $task == 'migrate' || $task == 'grav_copy_upgrade')
    && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    // Pin the site's own db server. The element has to STAY PRESENT:
    // drush_hosting_clone_pre_hosting_task() and the post-task handlers read
    // $task->task_args['new_db_server'] unguarded, so dropping it turns
    // every Grav clone into a notice and a wrong comparison. The copy
    // upgrade's own dialog already pins it; this is the shared belt, and it
    // is what attaches the validation below to that dialog too.
    $form['parameters']['new_db_server'] = array(
      '#type' => 'value',
      '#value' => isset($node->db_server) ? $node->db_server : 0,
    );
    if ($task == 'clone') {
      $help = t('Cloning a Grav site copies the entire site capsule - content, configuration, accounts, themes and plugins - to the new domain name, and gives the copy its own security keys. The copy starts with encryption switched off: enable it for the new domain once the clone has been verified. Nothing is copied from a database, because a Grav capsule keeps everything in files, so the database server stays as it is. Migrate does not apply to Grav sites: use the Rename task to move this site to a new name on its own platform, or Upgrade a copy to place an upgraded copy on another Grav platform.');
      // '#markup' is what Drupal 7 renders; the '#value' key is what the
      // generic confirm form carries, kept for anything that reads it.
      $form['help'] = array('#markup' => '<p>' . $help . '</p>', '#value' => $help);
    }
    $form['#validate'][] = 'hosting_grav_task_confirm_form_validate';
    return;
  }

  // A non-Grav site must never be offered the no-database server, on any
  // dialog that offers a db server (clone, migrate, the Backdrop upgrades).
  if (!isset($form['parameters']['new_db_server']['#type'])
    || $form['parameters']['new_db_server']['#type'] != 'radios'
    || !isset($form['parameters']['new_db_server']['#options'])
    || !is_array($form['parameters']['new_db_server']['#options'])) {
    return;
  }
  $none = hosting_grav_none_db_servers();
  if (empty($none)) {
    return;
  }
  $options = $form['parameters']['new_db_server']['#options'];
  foreach ($none as $none_nid => $none_title) {
    unset($options[$none_nid]);
  }
  if (empty($options)) {
    // Every option was a no-database server. Leave the form exactly as it
    // was rather than present an empty required control.
    return;
  }
  if (count($options) == 1) {
    // One option is not a choice -- hosting_task_migrate_form() renders that
    // same case as a fixed value rather than a single radio.
    $remaining = array_keys($options);
    $form['parameters']['new_db_server'] = array(
      '#type' => 'value',
      '#value' => $remaining[0],
    );
  }
  else {
    $form['parameters']['new_db_server']['#options'] = $options;
  }
}

/**
 * Validation belt for the clone/migrate dialog on a Grav site.
 *
 * The pinned value element makes this unreachable through the rendered form;
 * the belt is for a crafted post and for any later alter that puts the radios
 * back.
 */
function hosting_grav_task_confirm_form_validate($form, &$form_state) {
  if (!isset($form['parameters']['#node']) || !is_object($form['parameters']['#node'])) {
    return;
  }
  $node = $form['parameters']['#node'];
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return;
  }
  if (!isset($form_state['values']['parameters']['new_db_server'])) {
    return;
  }
  if ($form_state['values']['parameters']['new_db_server'] != $node->db_server) {
    form_set_error('parameters][new_db_server', t('Grav sites carry no database: this site keeps the database server it was created with.'));
  }
}

/**
 * Implements hook_node_validate().
 *
 * A Grav capsule has no database, so its site node must point at the
 * no-database server: attached to a real one the backend builds a database
 * the site will never use, and the Grav clone and restore paths refuse the
 * site outright. The site form offers every db server
 * (hosting_get_servers('db')), so the wrong choice is caught here.
 *
 * Only form submissions reach hook_node_validate. Programmatic node_save()
 * -- the clone post-task handler, the import path -- is deliberately
 * untouched: those copy a db_server that was already validated.
 */
function hosting_grav_node_validate($node, $form, &$form_state) {
  if (!isset($node->type) || $node->type != 'site') {
    return;
  }
  // The db server is chosen ONCE, on the create form: the edit form of an
  // existing site renders it as a display-only value the operator cannot
  // change, so an error there could never be cleared and would lock every
  // pre-existing site's edit form. Only a new node is judged here.
  if (!empty($node->nid)) {
    return;
  }
  if (!isset($node->db_server)) {
    return;
  }
  $is_grav = isset($node->platform) && hosting_grav_platform_is_grav($node->platform);
  $on_none = hosting_grav_db_server_is_none($node->db_server);
  if ($is_grav && !$on_none && hosting_grav_none_db_servers()) {
    // No 'none' server on this panel means there is nothing to point the
    // operator at (the backend says so at install time); refusing would
    // only make Grav sites uncreatable, hence the third condition.
    form_set_error('db_server', t('Grav sites carry no database yet: attach this site to the "None (flat-file sites)" database server.'));
  }
  elseif (!$is_grav && $on_none) {
    // The symmetric half: the no-database server maps to a null service,
    // so a Drupal or Backdrop site attached to it would install with no
    // database at all.
    form_set_error('db_server', t('The "None (flat-file sites)" database server carries no database: only Grav sites may use it.'));
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * The panel-wide default database server (used for imports and every site
 * created without an explicit choice) must never be the no-database one.
 */
function hosting_grav_form_hosting_settings_alter(&$form, &$form_state) {
  if (!isset($form['hosting_default_db_server']['#options']) || !is_array($form['hosting_default_db_server']['#options'])) {
    return;
  }
  foreach (hosting_grav_none_db_servers() as $none_nid => $none_title) {
    unset($form['hosting_default_db_server']['#options'][$none_nid]);
  }
}

/**
 * Implements hook_hosting_tasks_alter().
 *
 * The backend refuses Migrate (and the rename it performs) for Grav sites,
 * so the button must not be offered: a queued task that can only fail is
 * worse than no button.
 *
 * Composition matters -- hosting_txp installs the same kind of wrapper on
 * the same task. Whichever alter runs second has to wrap the first rather
 * than replace it, so read the CURRENT callback here and remember it, and
 * never assume the shipped default.
 */
function hosting_grav_hosting_tasks_alter(&$tasks) {
  if (!isset($tasks['site']['migrate'])) {
    return;
  }
  if (isset($tasks['site']['migrate']['access callback'])
    && $tasks['site']['migrate']['access callback'] == 'hosting_grav_migrate_task_access') {
    return;
  }
  if (!empty($tasks['site']['migrate']['access callback'])) {
    $tasks['site']['migrate']['hosting_grav_prev_access'] = $tasks['site']['migrate']['access callback'];
  }
  $tasks['site']['migrate']['access callback'] = 'hosting_grav_migrate_task_access';
}

/**
 * Access callback for the site migrate task.
 *
 * Denies Grav sites and delegates everything else to whichever callback was
 * in place before this module wrapped it (hosting_task_menu_access() when
 * nothing else had). Read at call time from the task registry, which is
 * already built and statically cached by the time any access callback runs.
 */
function hosting_grav_migrate_task_access($node, $task) {
  if (isset($node->type) && $node->type == 'site'
    && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }

  $previous = '';
  $site_tasks = hosting_available_tasks('site');
  if (isset($site_tasks[$task]['hosting_grav_prev_access'])) {
    $previous = $site_tasks[$task]['hosting_grav_prev_access'];
  }
  if ($previous !== '' && $previous != 'hosting_grav_migrate_task_access' && function_exists($previous)) {
    return $previous($node, $task);
  }

  return hosting_task_menu_access($node, $task);
}
