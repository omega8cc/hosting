<?php
/**
 * @file
 * Grav 2 platform support for the Aegir frontend.
 *
 * The frontend is version-agnostic: no node column records the CMS. The
 * backend (provision grav layer) reports the Grav signal on platform verify
 * as $data['grav'] = the Grav version string. This module stores that marker
 * per platform, then uses it to (a) keep Grav and Drupal platforms from being
 * offered together at site creation, (b) route Grav site installs through the
 * Grav path via context_options, (c) offer the mirror-fed core+bundle Upgrade
 * task, and (d) provide the 'none' db service type flat-file sites attach to
 * (a real, selectable db_server node whose context maps to
 * Provision_Service_null — boa-grav map par.1.3).
 *
 * PHP 5.6 floor: this file is loaded under the Drush-8 backend and must stay
 * 5.6-parseable (the D7 hostmaster floor, independent of the grav-layer
 * D-005 ruling).
 */

/**
 * Variable-name prefix for the per-platform Grav version marker.
 *
 * Keyed by platform nid; the value is the reported Grav version string.
 * Table-free storage (the {variable} table) keeps this a pure submodule with
 * no schema change to the shared hosting_platform table.
 */
define('HOSTING_GRAV_PLATFORM_VAR', 'hosting_grav_platform_version_');

/**
 * The install_method value the provision grav layer expects for Grav sites.
 */
define('HOSTING_GRAV_INSTALL_METHOD', 'grav');

/**
 * Determine whether a platform node is a verified Grav platform.
 *
 * @param int $platform_nid
 *   The platform node id.
 *
 * @return bool
 *   TRUE if the backend reported a Grav version for this platform.
 */
function hosting_grav_platform_is_grav($platform_nid) {
  if (empty($platform_nid)) {
    return FALSE;
  }
  $version = variable_get(HOSTING_GRAV_PLATFORM_VAR . $platform_nid, '');
  return $version !== '';
}

/**
 * Return the stored Grav version string for a platform, or ''.
 */
function hosting_grav_platform_version($platform_nid) {
  if (empty($platform_nid)) {
    return '';
  }
  return variable_get(HOSTING_GRAV_PLATFORM_VAR . $platform_nid, '');
}

/**
 * Implements hook_hosting_service().
 */
function hosting_grav_hosting_service() {
  return array(
    'none' => 'db',
  );
}

/**
 * Return every no-database server node on this panel, keyed by nid.
 *
 * hosting_get_servers('db') cannot answer this question: it returns every
 * server with an available db service whatever its TYPE, and it tags the
 * query with node_access — from drush or any non-web context that list can
 * come back empty for reasons that have nothing to do with the servers. So
 * this query is deliberately untagged, and joins on the CURRENT revision
 * (n.vid) so a service disabled in a newer revision stops counting.
 *
 * @param bool $reset
 *   TRUE to re-read after creating or changing a server in this request.
 *
 * @return array
 *   nid => title; empty when the panel has no 'none' server.
 */
function hosting_grav_none_db_servers($reset = FALSE) {
  $servers = &drupal_static(__FUNCTION__, NULL);
  if ($reset) {
    $servers = NULL;
  }
  if (is_array($servers)) {
    return $servers;
  }

  $servers = array();
  $query = db_select('node', 'n');
  $query->join('hosting_service', 's', 'n.vid = s.vid');
  $query
    ->fields('n', array('nid', 'title'))
    ->condition('n.type', 'server')
    ->condition('s.service', 'db')
    ->condition('s.type', 'none')
    ->condition('s.available', 1);
  $result = $query->execute();
  foreach ($result as $server) {
    $servers[$server->nid] = $server->title;
  }

  return $servers;
}

/**
 * Determine whether a db server node is a no-database ('none') server.
 */
function hosting_grav_db_server_is_none($nid) {
  if (empty($nid)) {
    return FALSE;
  }
  $servers = hosting_grav_none_db_servers();
  return isset($servers[$nid]);
}

/**
 * Create the no-database server node, once, if the panel has none.
 *
 * Flat-file capsules need a REAL db_server node to point at (db_server = 0
 * emits a hosting_context_name(0) error on every install and verify), and
 * the only way to get one is to create a server whose db service is of type
 * 'none'. Doing it by hand is a five-field form an operator has no reason to
 * know about, so the module that defines the service type also ships it.
 *
 * Idempotent by construction: it returns early when a 'none' server already
 * exists, which is what makes it safe from both hook_enable (first
 * enablement) and hook_update_N (panels that enabled the module before this
 * code existed).
 *
 * @return object|false
 *   The created server node, or FALSE when nothing was created.
 */
function hosting_grav_ensure_none_db_server() {
  // Without the service API the node would be saved with no db service at
  // all -- an unselectable server that looks like a bug. hosting_server is a
  // dependency of hosting itself, but enable order is not ours to assume.
  if (!function_exists('hosting_services_add') || !function_exists('_hosting_valid_fqdn_ip')) {
    return FALSE;
  }
  // A partial bootstrap (update.php, where hook_init never ran and the
  // hosting constants do not exist) cannot save a node: the node-access
  // hooks die on the missing constants. Leave it to a full request.
  if (!defined('HOSTING_DEFAULT_DB_SERVER')) {
    return FALSE;
  }
  if (hosting_grav_none_db_servers(TRUE)) {
    return FALSE;
  }

  // A server title must be hostname-shaped (hosting_server_validate() runs
  // _hosting_valid_fqdn_ip on it), so name the server after the panel.
  $host = '';
  if (function_exists('hosting_get_hostmaster_site_nid')) {
    $hostmaster_nid = hosting_get_hostmaster_site_nid();
    if (!empty($hostmaster_nid)) {
      $hostmaster = node_load($hostmaster_nid);
      if (is_object($hostmaster) && !empty($hostmaster->title)) {
        $host = $hostmaster->title;
      }
    }
  }
  if ($host === '') {
    $host = php_uname('n');
  }
  $title = 'none.' . drupal_strtolower(trim($host));
  if (!_hosting_valid_fqdn_ip($title)) {
    drupal_set_message(t('Hosting Grav could not derive a valid hostname for the "None (flat-file sites)" database server (tried @title). Add the server by hand, with its database service set to the "None" type, before creating Grav sites.', array('@title' => $title)), 'warning');
    return FALSE;
  }

  $node = new stdClass();
  $node->type = 'server';
  node_object_prepare($node);
  $node->uid = 1;
  $node->status = 1;
  $node->title = $title;
  $node->human_name = 'None (flat-file sites)';
  // hosting_services_add(), never a bare hosting_services_new_object(): only
  // this path sets available, and a service with available = 0 makes the
  // server invisible to hosting_get_servers('db') -- that is, unselectable
  // everywhere, which is exactly the failure this function exists to avoid.
  hosting_services_add($node, 'db', 'none', array('available' => 1));
  node_save($node);
  hosting_grav_none_db_servers(TRUE);

  drupal_set_message(t('Hosting Grav created the "None (flat-file sites)" database server @title for flat-file site capsules.', array('@title' => $node->title)));

  return $node;
}

/**
 * Implements hook_init().
 *
 * The one deferred job: create the no-database server that an update hook
 * asked for (it cannot save nodes itself). One cached variable read per
 * request while nothing is pending; the flag is cleared on the first full
 * request that manages to create the server, or finds one.
 */
function hosting_grav_init() {
  if (!variable_get('hosting_grav_none_server_wanted', 0)) {
    return;
  }
  if (hosting_grav_none_db_servers(TRUE) || hosting_grav_ensure_none_db_server()) {
    variable_del('hosting_grav_none_server_wanted');
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Stores (or clears) the per-platform Grav marker from the verify result.
 * The backend contract: the grav layer's platform verify adds
 * $data['grav'] = the Grav version string alongside the standard
 * packages/profiles/sites keys. Presence of that key is the Grav signal.
 */
function hosting_grav_post_hosting_verify_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'platform') {
    return;
  }
  $name = HOSTING_GRAV_PLATFORM_VAR . $task->ref->nid;

  // Read the reported version; tolerate it arriving nested under 'context'.
  $version = '';
  if (isset($data['grav']) && is_string($data['grav'])) {
    $version = trim($data['grav']);
  }
  elseif (isset($data['context']['grav']) && is_string($data['context']['grav'])) {
    $version = trim($data['context']['grav']);
  }

  if ($version !== '') {
    // Only write on change to avoid needless variable-cache invalidation.
    if (variable_get($name, '') !== $version) {
      variable_set($name, $version);
    }
  }
  else {
    // Re-verified as a non-Grav platform: drop any stale marker. Guard the
    // delete so a normal Drupal verify never clears the bootstrap cache.
    if (variable_get($name, NULL) !== NULL) {
      variable_del($name);
    }
  }
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * The upgrade takes a safety copy of the capsule before touching it; record
 * it the way the clone records its pre-clone copy, so it appears on the
 * site's backups list (restorable, deletable) instead of sitting on disk
 * unregistered until the retention sweep.
 */
function hosting_grav_post_hosting_grav_upgrade_task($task, $data) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  if (empty($data['context']['backup_file']) || !function_exists('hosting_site_post_hosting_backup_task')) {
    return;
  }
  $task->task_args['description'] = t('Pre-upgrade backup');
  hosting_site_post_hosting_backup_task($task, $data);
}

/**
 * Implements hook_post_hosting_TASK_TYPE_task().
 *
 * Cleans up the per-platform marker when a platform is deleted.
 */
function hosting_grav_post_hosting_delete_task($task, $data) {
  if (isset($task->ref) && $task->ref->type == 'platform') {
    $name = HOSTING_GRAV_PLATFORM_VAR . $task->ref->nid;
    if (variable_get($name, NULL) !== NULL) {
      variable_del($name);
    }
  }
}

/**
 * Implements hook_hosting_site_options_alter().
 *
 * Partition the platform options so Grav and non-Grav platforms are never
 * offered together (the distinct synthetic 'grav' profile already keeps the
 * lists apart on the create form; this is the belt covering migrate/clone
 * option paths, symmetric in both directions — the hosting_backdrop shape).
 */
function hosting_grav_hosting_site_options_alter(&$return, &$node) {
  if (empty($return['platform']) || !is_array($return['platform'])) {
    return;
  }

  $reference = isset($node->platform) ? $node->platform : reset($return['platform']);
  if (empty($reference)) {
    return;
  }
  $reference_is_grav = hosting_grav_platform_is_grav($reference);

  $filtered = array();
  foreach ($return['platform'] as $nid) {
    if (hosting_grav_platform_is_grav($nid) == $reference_is_grav) {
      $filtered[] = $nid;
    }
  }

  // Never present an empty platform list; only apply a non-empty partition.
  if (!empty($filtered)) {
    $return['platform'] = $filtered;
  }
}

/**
 * Implements hook_permission().
 *
 * The "create TASK_TYPE task" permission string is load-bearing:
 * hosting_task_menu_access() gates both the Run button and the confirm path
 * on user_access("create grav_upgrade task").
 */
function hosting_grav_permission() {
  return array(
    'create grav_upgrade task' => array(
      'title' => t('create grav_upgrade task'),
    ),
  );
}

/**
 * Implements hook_hosting_tasks().
 *
 * The 'command' key is mandatory: the default derivation would yield
 * provision-grav_upgrade (underscore), which does not exist. The task is
 * per-SITE by design (D-003 capsules upgrade independently); the artefact is
 * resolved backend-side from the mirror-fed staging directory (D-004/D-006),
 * so no dialog and no arguments.
 */
function hosting_grav_hosting_tasks() {
  $tasks = array();

  $tasks['site']['grav_upgrade'] = array(
    'title' => t('Upgrade Grav'),
    'description' => t('Upgrade this site capsule to the newest staged official Grav release (core + admin bundle, fetched from our mirrors — never a third-party download on this box). A safety backup is taken first; user content, accounts and configuration survive the upgrade in place.'),
    'command' => 'provision-grav-upgrade',
    'access callback' => 'hosting_grav_upgrade_task_access',
    // A dialog, like every sibling task: the confirm form's token is the
    // CSRF check. The custom access callback above replaces the menu item's
    // token-checking one, and without a dialog a plain GET on the confirm
    // path queued the task.
    'dialog' => TRUE,
  );

  return $tasks;
}

/**
 * Access callback for the grav_upgrade task.
 *
 * Same two-context posture as the hosting_backdrop callbacks (button render +
 * hosting_confirm menu item; must not require the URL token — none exists at
 * button-render time). Only an ENABLED site on a marker-verified Grav
 * platform gets the button.
 */
function hosting_grav_upgrade_task_access($node, $task) {
  if (!hosting_task_menu_access($node, $task)) {
    return FALSE;
  }
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }
  if (!isset($node->site_status) || $node->site_status != HOSTING_SITE_ENABLED) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements hook_preprocess_node().
 *
 * Badge Grav platforms and their sites in the admin theme: a small
 * title-suffix label plus node classes (platform-grav / site-grav) the eldir
 * theme can style. A theme without the CSS just shows the plain label.
 */
function hosting_grav_preprocess_node(&$variables) {
  if (empty($variables['node']) || !is_object($variables['node'])) {
    return;
  }
  $node = $variables['node'];
  $version = '';
  $class = '';
  if ($node->type == 'platform' && hosting_grav_platform_is_grav($node->nid)) {
    $version = hosting_grav_platform_version($node->nid);
    $class = 'platform-grav';
  }
  elseif ($node->type == 'site' && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    $version = hosting_grav_platform_version($node->platform);
    $class = 'site-grav';
  }
  if ($class === '') {
    return;
  }
  $variables['classes_array'][] = $class;
  $label = $version !== '' ? t('Grav @version', array('@version' => $version)) : t('Grav');
  $variables['title_suffix']['grav_badge'] = array(
    '#markup' => ' <span class="grav-badge">' . $label . '</span>',
  );
}

/**
 * Implements hook_hosting_TASK_OBJECT_context_options().
 *
 * For a site on a Grav platform, tell the backend to install through the Grav
 * path. The generic seam (hosting_site.drush.inc) only forwards an
 * install_method already present on the node; there is no persistent
 * install_method column, so derive it here from the platform's Grav marker.
 * Respect an install_method another module may already have set.
 */
function hosting_grav_hosting_site_context_options(&$task) {
  if (!isset($task->ref) || $task->ref->type != 'site') {
    return;
  }
  if (!empty($task->context_options['install_method'])) {
    return;
  }
  if (isset($task->ref->platform) && hosting_grav_platform_is_grav($task->ref->platform)) {
    $task->context_options['install_method'] = HOSTING_GRAV_INSTALL_METHOD;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * The clone and migrate dialogs ask which DATABASE SERVER the copy should
 * use (hosting_task_migrate_form(), reused verbatim by
 * hosting_task_clone_form()) and they offer every server that has an
 * available db service. On a panel that carries both a MySQL server and the
 * flat-file 'none' server, that control is a REQUIRED choice between two
 * wrong answers: it lets an operator attach a DB-less Grav capsule to MySQL,
 * or a Drupal site to the no-database server. The backend refuses a Grav
 * clone or restore whose site is attached to a real database server, so the
 * front end must not offer it in the first place.
 */
function hosting_grav_form_hosting_task_confirm_form_alter(&$form, &$form_state) {
  if (!isset($form['task']['#value'])) {
    return;
  }
  $task = $form['task']['#value'];
  if (!isset($form['parameters']['new_db_server'])) {
    return;
  }
  // The site node rides into the confirm form on the dialogs that offer a
  // db server (hosting_task_migrate_form() sets $form['#node'], merged in
  // under 'parameters'; the Backdrop upgrade dialogs do the same); the menu
  // callback's node is the fallback.
  $node = NULL;
  if (isset($form['parameters']['#node']) && is_object($form['parameters']['#node'])) {
    $node = $form['parameters']['#node'];
  }
  elseif (isset($form['nid']['#value'])) {
    $node = node_load($form['nid']['#value']);
  }
  if (!is_object($node) || !isset($node->type) || $node->type != 'site') {
    return;
  }

  if (($task == 'clone' || $task == 'migrate')
    && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    // Pin the site's own db server. The element has to STAY PRESENT:
    // drush_hosting_clone_pre_hosting_task() and the post-task handlers read
    // $task->task_args['new_db_server'] unguarded, so dropping it turns
    // every Grav clone into a notice and a wrong comparison.
    $form['parameters']['new_db_server'] = array(
      '#type' => 'value',
      '#value' => isset($node->db_server) ? $node->db_server : 0,
    );
    if ($task == 'clone') {
      $help = t('Cloning a Grav site copies the entire site capsule - content, configuration, accounts, themes and plugins - to the new domain name, and gives the copy its own security keys. The copy starts with encryption switched off: enable it for the new domain once the clone has been verified. Nothing is copied from a database, because a Grav capsule keeps everything in files, so the database server stays as it is. Migrate, and the rename it performs, is not offered for Grav sites yet.');
      // '#markup' is what Drupal 7 renders; the '#value' key is what the
      // generic confirm form carries, kept for anything that reads it.
      $form['help'] = array('#markup' => '<p>' . $help . '</p>', '#value' => $help);
    }
    $form['#validate'][] = 'hosting_grav_task_confirm_form_validate';
    return;
  }

  // A non-Grav site must never be offered the no-database server, on any
  // dialog that offers a db server (clone, migrate, the Backdrop upgrades).
  if (!isset($form['parameters']['new_db_server']['#type'])
    || $form['parameters']['new_db_server']['#type'] != 'radios'
    || !isset($form['parameters']['new_db_server']['#options'])
    || !is_array($form['parameters']['new_db_server']['#options'])) {
    return;
  }
  $none = hosting_grav_none_db_servers();
  if (empty($none)) {
    return;
  }
  $options = $form['parameters']['new_db_server']['#options'];
  foreach ($none as $none_nid => $none_title) {
    unset($options[$none_nid]);
  }
  if (empty($options)) {
    // Every option was a no-database server. Leave the form exactly as it
    // was rather than present an empty required control.
    return;
  }
  if (count($options) == 1) {
    // One option is not a choice -- hosting_task_migrate_form() renders that
    // same case as a fixed value rather than a single radio.
    $remaining = array_keys($options);
    $form['parameters']['new_db_server'] = array(
      '#type' => 'value',
      '#value' => $remaining[0],
    );
  }
  else {
    $form['parameters']['new_db_server']['#options'] = $options;
  }
}

/**
 * Validation belt for the clone/migrate dialog on a Grav site.
 *
 * The pinned value element makes this unreachable through the rendered form;
 * the belt is for a crafted post and for any later alter that puts the radios
 * back.
 */
function hosting_grav_task_confirm_form_validate($form, &$form_state) {
  if (!isset($form['parameters']['#node']) || !is_object($form['parameters']['#node'])) {
    return;
  }
  $node = $form['parameters']['#node'];
  if (!isset($node->platform) || !hosting_grav_platform_is_grav($node->platform)) {
    return;
  }
  if (!isset($form_state['values']['parameters']['new_db_server'])) {
    return;
  }
  if ($form_state['values']['parameters']['new_db_server'] != $node->db_server) {
    form_set_error('parameters][new_db_server', t('Grav sites carry no database: this site keeps the database server it was created with.'));
  }
}

/**
 * Implements hook_node_validate().
 *
 * A Grav capsule has no database, so its site node must point at the
 * no-database server: attached to a real one the backend builds a database
 * the site will never use, and the Grav clone and restore paths refuse the
 * site outright. The site form offers every db server
 * (hosting_get_servers('db')), so the wrong choice is caught here.
 *
 * Only form submissions reach hook_node_validate. Programmatic node_save()
 * -- the clone post-task handler, the import path -- is deliberately
 * untouched: those copy a db_server that was already validated.
 */
function hosting_grav_node_validate($node, $form, &$form_state) {
  if (!isset($node->type) || $node->type != 'site') {
    return;
  }
  // The db server is chosen ONCE, on the create form: the edit form of an
  // existing site renders it as a display-only value the operator cannot
  // change, so an error there could never be cleared and would lock every
  // pre-existing site's edit form. Only a new node is judged here.
  if (!empty($node->nid)) {
    return;
  }
  if (!isset($node->db_server)) {
    return;
  }
  $is_grav = isset($node->platform) && hosting_grav_platform_is_grav($node->platform);
  $on_none = hosting_grav_db_server_is_none($node->db_server);
  if ($is_grav && !$on_none && hosting_grav_none_db_servers()) {
    // No 'none' server on this panel means there is nothing to point the
    // operator at (the backend says so at install time); refusing would
    // only make Grav sites uncreatable, hence the third condition.
    form_set_error('db_server', t('Grav sites carry no database yet: attach this site to the "None (flat-file sites)" database server.'));
  }
  elseif (!$is_grav && $on_none) {
    // The symmetric half: the no-database server maps to a null service,
    // so a Drupal or Backdrop site attached to it would install with no
    // database at all.
    form_set_error('db_server', t('The "None (flat-file sites)" database server carries no database: only Grav sites may use it.'));
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * The panel-wide default database server (used for imports and every site
 * created without an explicit choice) must never be the no-database one.
 */
function hosting_grav_form_hosting_settings_alter(&$form, &$form_state) {
  if (!isset($form['hosting_default_db_server']['#options']) || !is_array($form['hosting_default_db_server']['#options'])) {
    return;
  }
  foreach (hosting_grav_none_db_servers() as $none_nid => $none_title) {
    unset($form['hosting_default_db_server']['#options'][$none_nid]);
  }
}

/**
 * Implements hook_hosting_tasks_alter().
 *
 * The backend refuses Migrate (and the rename it performs) for Grav sites,
 * so the button must not be offered: a queued task that can only fail is
 * worse than no button.
 *
 * Composition matters -- hosting_txp installs the same kind of wrapper on
 * the same task. Whichever alter runs second has to wrap the first rather
 * than replace it, so read the CURRENT callback here and remember it, and
 * never assume the shipped default.
 */
function hosting_grav_hosting_tasks_alter(&$tasks) {
  if (!isset($tasks['site']['migrate'])) {
    return;
  }
  if (isset($tasks['site']['migrate']['access callback'])
    && $tasks['site']['migrate']['access callback'] == 'hosting_grav_migrate_task_access') {
    return;
  }
  if (!empty($tasks['site']['migrate']['access callback'])) {
    $tasks['site']['migrate']['hosting_grav_prev_access'] = $tasks['site']['migrate']['access callback'];
  }
  $tasks['site']['migrate']['access callback'] = 'hosting_grav_migrate_task_access';
}

/**
 * Access callback for the site migrate task.
 *
 * Denies Grav sites and delegates everything else to whichever callback was
 * in place before this module wrapped it (hosting_task_menu_access() when
 * nothing else had). Read at call time from the task registry, which is
 * already built and statically cached by the time any access callback runs.
 */
function hosting_grav_migrate_task_access($node, $task) {
  if (isset($node->type) && $node->type == 'site'
    && isset($node->platform) && hosting_grav_platform_is_grav($node->platform)) {
    return FALSE;
  }

  $previous = '';
  $site_tasks = hosting_available_tasks('site');
  if (isset($site_tasks[$task]['hosting_grav_prev_access'])) {
    $previous = $site_tasks[$task]['hosting_grav_prev_access'];
  }
  if ($previous !== '' && $previous != 'hosting_grav_migrate_task_access' && function_exists($previous)) {
    return $previous($node, $task);
  }

  return hosting_task_menu_access($node, $task);
}
