<?php
/**
 * @file
 * Install, uninstall and requirements hooks for hosting_grav.
 */

/**
 * Implements hook_enable().
 *
 * Marker backfill sweep (the hosting_backdrop shape). The per-platform Grav
 * marker derives from the verify result ($data['grav']) and is written only
 * while this module is enabled — a Grav platform verified before (first)
 * enablement, or during a disabled gap, carries no marker and would read as
 * Drupal to the platform partition and the task access callbacks. The marker
 * cannot be synthesized at enable time, so queue a verify for every live
 * platform; verifies are idempotent and Drupal platforms simply confirm
 * their (absent) marker.
 */
function hosting_grav_enable() {
  // BOUNDED: on a platform-heavy panel an unconditional sweep is a task
  // storm (E2E-observed: 84 platform verifies queued on the test panel in
  // one enable; the hosting-frontend analysis predicted exactly this). Above
  // the bound, tell the operator instead — only Grav platforms need the
  // marker, and verifying those specifically is cheap.
  $platforms = _hosting_get_platforms();
  if (count($platforms) > 25) {
    drupal_set_message(t('Hosting Grav did NOT queue the marker backfill sweep (@count platforms — too many to verify blindly). Run a Verify task on each GRAV platform to populate its marker; Drupal platforms need nothing.', array('@count' => count($platforms))), 'warning');
    return;
  }
  $queued = 0;
  foreach ($platforms as $nid => $title) {
    if (hosting_task_outstanding($nid, 'verify')) {
      continue;
    }
    hosting_add_task($nid, 'verify');
    $queued++;
  }
  if ($queued) {
    drupal_set_message(t('Hosting Grav queued a verify for @count platform(s) to refresh the Grav platform markers.', array('@count' => $queued)));
  }
}

/**
 * Implements hook_uninstall().
 *
 * Drop the per-platform Grav version markers this module stored in the
 * {variable} table (keyed by platform nid).
 */
function hosting_grav_uninstall() {
  // db_like() escapes the underscores in the prefix so LIKE matches literally.
  $prefix = db_like('hosting_grav_platform_version_') . '%';
  db_delete('variable')
    ->condition('name', $prefix, 'LIKE')
    ->execute();
  cache_clear_all('variables', 'cache_bootstrap');
}

/**
 * Implements hook_requirements().
 *
 * Best-effort probe: warn (never error) when the provision grav engine layer
 * is not found on the backend. Grav platform verify and site install tasks
 * need it; BOA deploys provision at ${_ROOT}/.drush/sys/provision.
 */
function hosting_grav_requirements($phase) {
  $requirements = array();
  if ($phase != 'runtime') {
    return $requirements;
  }

  $home = '';
  if (function_exists('posix_geteuid') && function_exists('posix_getpwuid')) {
    $info = posix_getpwuid(posix_geteuid());
    if (!empty($info['dir'])) {
      $home = $info['dir'];
    }
  }
  if (empty($home)) {
    $home = getenv('HOME');
  }

  $found = FALSE;
  $expected = '${_ROOT}/.drush/sys/provision/grav';
  if (!empty($home)) {
    $expected = $home . '/.drush/sys/provision/grav';
    if (is_readable($expected . '/provision_grav.drush.inc')) {
      $found = TRUE;
    }
  }

  if ($found) {
    $requirements['hosting_grav_engine'] = array(
      'title' => t('Grav provision layer'),
      'value' => t('Installed (@path)', array('@path' => $expected)),
      'severity' => REQUIREMENT_OK,
    );
  }
  else {
    $requirements['hosting_grav_engine'] = array(
      'title' => t('Grav provision layer'),
      'value' => t('Not detected'),
      'description' => t('The provision grav engine layer was not found under the backend Drush command path (expected at @path). Grav platform verify and site install tasks require it.', array('@path' => $expected)),
      'severity' => REQUIREMENT_WARNING,
    );
  }

  return $requirements;
}
