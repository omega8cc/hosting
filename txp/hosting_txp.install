<?php
/**
 * @file
 * Install, uninstall and requirements hooks for hosting_txp.
 */

/**
 * Implements hook_enable().
 *
 * Marker backfill sweep. The per-platform TXP marker derives from the verify
 * result ($data['txp']) and is written only while this module is enabled — a
 * Textpattern platform verified before (first) enablement, or during a
 * disabled gap, carries no marker and would read as Drupal to the platform
 * partition and the install-method routing. The marker cannot be synthesized
 * at enable time, so queue a verify for every live platform; verifies are
 * idempotent and Drupal platforms simply confirm their (absent) marker.
 */
function hosting_txp_enable() {
  // BOUNDED from the start: on a platform-heavy panel an unconditional sweep
  // is a task storm (the grav track observed 84 platform verifies queued in a
  // single enable on the shared test panel, which also carries a long backlog
  // of ancient queued tasks). Above the bound, tell the operator instead —
  // only Textpattern platforms need the marker, and verifying those
  // specifically is cheap.
  $platforms = _hosting_get_platforms();
  if (count($platforms) > 25) {
    drupal_set_message(t('Hosting Textpattern did NOT queue the marker backfill sweep (@count platforms — too many to verify blindly). Run a Verify task on each TEXTPATTERN platform to populate its marker; Drupal platforms need nothing.', array('@count' => count($platforms))), 'warning');
    return;
  }
  $queued = 0;
  foreach ($platforms as $nid => $title) {
    if (hosting_task_outstanding($nid, 'verify')) {
      continue;
    }
    hosting_add_task($nid, 'verify');
    $queued++;
  }
  if ($queued) {
    drupal_set_message(t('Hosting Textpattern queued a verify for @count platform(s) to refresh the Textpattern platform markers.', array('@count' => $queued)));
  }
}

/**
 * Implements hook_uninstall().
 *
 * Drop the per-platform Textpattern version markers this module stored in the
 * {variable} table (keyed by platform nid).
 */
function hosting_txp_uninstall() {
  // db_like() escapes the underscores in the prefix so LIKE matches literally.
  $prefix = db_like('hosting_txp_platform_version_') . '%';
  db_delete('variable')
    ->condition('name', $prefix, 'LIKE')
    ->execute();
  cache_clear_all('variables', 'cache_bootstrap');
}

/**
 * Implements hook_requirements().
 *
 * Best-effort probe: warn (never error) when the provision txp engine layer
 * is not found on the backend. Textpattern platform verify and site install
 * tasks need it; BOA deploys provision at ${_ROOT}/.drush/sys/provision.
 */
function hosting_txp_requirements($phase) {
  $requirements = array();
  if ($phase != 'runtime') {
    return $requirements;
  }

  $home = '';
  if (function_exists('posix_geteuid') && function_exists('posix_getpwuid')) {
    $info = posix_getpwuid(posix_geteuid());
    if (!empty($info['dir'])) {
      $home = $info['dir'];
    }
  }
  if (empty($home)) {
    $home = getenv('HOME');
  }

  $found = FALSE;
  $expected = '${_ROOT}/.drush/sys/provision/txp';
  if (!empty($home)) {
    $expected = $home . '/.drush/sys/provision/txp';
    if (is_readable($expected . '/provision_txp.drush.inc')) {
      $found = TRUE;
    }
  }

  if ($found) {
    $requirements['hosting_txp_engine'] = array(
      'title' => t('Textpattern provision layer'),
      'value' => t('Installed (@path)', array('@path' => $expected)),
      'severity' => REQUIREMENT_OK,
    );
  }
  else {
    $requirements['hosting_txp_engine'] = array(
      'title' => t('Textpattern provision layer'),
      'value' => t('Not detected'),
      'description' => t('The provision txp engine layer was not found under the backend Drush command path (expected at @path). Textpattern platform verify and site install tasks require it.', array('@path' => $expected)),
      'severity' => REQUIREMENT_WARNING,
    );
  }

  return $requirements;
}
